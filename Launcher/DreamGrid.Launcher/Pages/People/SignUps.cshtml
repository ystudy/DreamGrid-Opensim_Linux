@page "/people/sign-ups"
@model DreamGrid.Launcher.Pages.People.SignUpsModel
@{
    ViewData["Title"] = "Sign-ups";
}
<h1>Sign-ups</h1>
<p>Everyone waiting, and the last 14 days of sign-ups that were let in or denied.</p>
@if (Model.Notice is not null)
{
    <div class="ok-box alert alert-info" role="status">@Model.Notice</div>
}
<form method="get" class="d-flex gap-2 mb-3" role="search">
    <label class="visually-hidden" for="q">Name</label>
    <input class="form-control" id="q" name="q" value="@Model.Q" placeholder="Search by name">
    @if (Model.Sort is not null)
    {
        <input type="hidden" name="sort" value="@Model.Sort">
        <input type="hidden" name="dir" value="@Model.Dir">
    }
    <button type="submit" class="btn btn-primary">Search</button>
</form>
<p class="small">Sort by: <a href="@Model.Link(sort: "name")">name</a> · <a href="@Model.Link(sort: "made")">sign-up time</a> · <a href="@Model.Link(sort: "state")">state</a></p>
<section id="signups-list" class="card card-body shadow-sm">
    <partial name="_SignUpRows" model="Model.Rows" />
</section>
@if (Model.Pages > 1)
{
    <nav class="mt-3" aria-label="Pages">
        <ul class="pagination">
            @for (var i = 1; i <= Model.Pages; i++)
            {
                <li class="page-item@(i == Model.PageNumber ? " active" : "")"><a class="page-link" href="@Model.Link(page: i)">@i</a></li>
            }
        </ul>
    </nav>
}
