@page "/people/takedowns/{number:regex(^TD-\d{{4}}-\d{{3,}}$)}/sender"
@model DreamGrid.Launcher.Pages.People.TakedownSenderModel
@using DreamGrid.Launcher.Pages.People
@{
    var c = Model.Case!;
    ViewData["Title"] = $"{c.Number} for the sender";
}
<p class="d-print-none"><a href="/people/takedowns/@c.Number">‹ @c.Number</a></p>
<div id="sender-record">
    <h1>@Model.GridName: takedown @c.Number</h1>
    <p>Notice from @c.Notice.SenderName@(c.Notice.Organisation is { } o ? $", {o}" : "")@(c.Notice.Reference is { } r ? $", reference {r}" : ""), received @TakedownAccess.Day(c.Notice.Received).</p>
    <table class="table table-sm">
        <thead><tr><th>Item</th><th>Type</th><th>Creator</th><th>Removed</th><th>Put back</th></tr></thead>
        <tbody>
            @foreach (var i in Model.Items)
            {
                <tr>
                    <td>@i.Name</td>
                    <td>@i.Type</td>
                    <td>@i.Creator</td>
                    <td>@PersonModel.When(i.RemovedAt)</td>
                    <td>@(i.PutBackAt is { } b ? PersonModel.When(b) : "")</td>
                </tr>
            }
        </tbody>
    </table>
    <p>Objects already placed in regions are not covered by this list.</p>
</div>
