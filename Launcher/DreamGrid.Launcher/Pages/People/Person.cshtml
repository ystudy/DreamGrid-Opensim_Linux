@page "/people/{id:guid}"
@model DreamGrid.Launcher.Pages.People.PersonModel
@{
    ViewData["Title"] = Model.Person?.FullName ?? "Person";
}
<p><a href="/people">‹ People</a></p>
@if (Model.Person is null)
{
    <h1>Person</h1>
    <div class="error-box error alert alert-danger" role="alert">@Model.Error</div>
}
else
{
    var p = Model.Person;
    var a = p.Row.Account;
    <text>
<h1>
    @p.FullName
    @if (p.Role.IsOwner) { <span class="badge text-bg-primary ms-2">Owner</span> }
    @if (p.Facts.Waiting) { <span class="badge text-bg-secondary ms-2">Waiting for approval</span> }
    else if (p.Facts.Suspended) { <span class="badge text-bg-danger ms-2">Suspended</span> }
</h1>
@if (Model.Error is not null)
{
    <div class="error-box error alert alert-danger" role="alert">@Model.Error</div>
}
@if (Model.Notice is not null)
{
    <div class="ok-box alert alert-success" role="status">@Model.Notice</div>
}
<dl id="person-details" class="row">
    <dt class="col-sm-3">Role</dt>
    <dd class="col-sm-9">@DreamGrid.Launcher.Pages.People.IndexModel.RoleWord(p)</dd>
    <dt class="col-sm-3">Level</dt>
    <dd class="col-sm-9">@a.UserLevel</dd>
    <dt class="col-sm-3">Email</dt>
    <dd class="col-sm-9">@(string.IsNullOrWhiteSpace(a.Email) ? "None" : a.Email)</dd>
    <dt class="col-sm-3">Created</dt>
    <dd class="col-sm-9">@DreamGrid.Launcher.Pages.People.PersonModel.When(a.Created)</dd>
    <dt class="col-sm-3">Last login</dt>
    <dd class="col-sm-9">@DreamGrid.Launcher.Pages.People.PersonModel.When(p.Row.LastLogin)</dd>
    <dt class="col-sm-3">Online now</dt>
    <dd class="col-sm-9">@(Model.OnlineIn is { } where ? $"Yes, in {where}" : "No")</dd>
    <dt class="col-sm-3">Region rights</dt>
    <dd class="col-sm-9">@(Model.Regions.Count == 0 ? "None" : string.Join(", ", Model.Regions))</dd>
    <dt class="col-sm-3">Estate</dt>
    <dd class="col-sm-9">@(Model.Estate ?? "None")</dd>
</dl>
@if (Model.HeldBy is { } held)
{
    <p id="person-hold" class="alert alert-warning">On hold: takedown <a href="/people/takedowns/@held">@held</a></p>
}
@if (Model.Takedowns is { } t)
{
    <p id="person-takedowns">Takedowns: <a href="/people/takedowns">named in @t.Named (@t.NamedOpen open); held a copy in @t.Copies</a></p>
}
<div id="person-upload" class="mb-3">
    <span>May upload models: @(Model.MayUpload ? "Yes" : "No")</span>
    @if (Model.UploadTask is { } upload)
    {
        var label = upload == DreamGrid.Launcher.Core.Security.PersonTask.StopUpload ? "Stop allowing uploads" : "Allow uploads";
        <form method="post" action="/people/@a.PrincipalId?handler=Task" asp-antiforgery="true" class="d-inline ms-2">
            <input type="hidden" name="id" value="@a.PrincipalId">
            <input type="hidden" name="task" value="@upload">
            <button type="submit" class="btn btn-sm people-icon btn-outline-secondary" data-task="@upload" title="@label" aria-label="@($"{label}: {p.FullName}")"><svg aria-hidden="true"><use href="/img/people-icons.svg#box"></use></svg><span class="ms-1">@label</span></button>
        </form>
    }
</div>
@if (Model.Iar is { } iar)
{
    var g = Model.GridIar;
    <section id="person-iar" class="card card-body mb-3">
        <h2 class="h6">Inventory backups</h2>
        @if (DreamGrid.Launcher.Pages.People.TakedownAccess.MayUse(User))
        {
            <p class="small mb-2"><a href="/people/@a.PrincipalId/iar">Inventory archives</a>: save or load this inventory as the owner or an admin, with a reason.</p>
        }
        <p class="small mb-2">For the whole grid, downloads are @(g.DownloadsOn ? "on" : "off") and uploads are @(g.UploadsOn ? "on" : "off"). These switches can only turn them off for this person.</p>
        @if (Model.IarEditable)
        {
            <form method="post" action="/people/@a.PrincipalId?handler=Iar" asp-antiforgery="true">
                <input type="hidden" name="id" value="@a.PrincipalId">
                <div class="form-check form-switch">
                    <input class="form-check-input" type="checkbox" role="switch" id="IarDownloadOn" name="IarDownloadOn" value="true" checked="@(!iar.DownloadOff)">
                    <label class="form-check-label" for="IarDownloadOn">May back up (download) their inventory</label>
                </div>
                <div class="form-check form-switch">
                    <input class="form-check-input" type="checkbox" role="switch" id="IarUploadOn" name="IarUploadOn" value="true" checked="@(!iar.UploadOff)">
                    <label class="form-check-label" for="IarUploadOn">May bring in (upload) inventory</label>
                </div>
                <p class="small mt-2 mb-1">Their own limits. Leave a box empty to use the grid's.</p>
                @foreach (var (field, label, own, grid) in new (string, string, int?, int)[]
                {
                    ("IarMaxUploadMb", "Largest upload (MB)", iar.MaxUploadMb, g.MaxUploadMb),
                    ("IarMaxDownloadMb", "Largest download (MB)", iar.MaxDownloadMb, g.MaxDownloadMb),
                    ("IarDownloadsPerDay", "Downloads per day", iar.DownloadsPerDay, g.DownloadsPerDay),
                    ("IarUploadsPerDay", "Uploads per day", iar.UploadsPerDay, g.UploadsPerDay),
                    ("IarDownloadKbPerSecond", "Download speed (KB a second)", iar.DownloadKbPerSecond, g.DownloadKbPerSecond),
                })
                {
                    <label class="form-label small mb-0 mt-1" for="@field">@label</label>
                    <input class="form-control form-control-sm w-auto" type="number" id="@field" name="@field" value="@own" placeholder="@grid" autocomplete="off">
                    <span class="form-text small">Use the grid's (@grid)</span>
                }
                <button type="submit" class="btn btn-sm btn-outline-primary mt-2">Save inventory backup settings</button>
            </form>
        }
        else
        {
            <p class="small mb-0">Download: @(iar.DownloadOff ? "off for them" : "as the grid") · Upload: @(iar.UploadOff ? "off for them" : "as the grid")</p>
        }
    </section>
}
<partial name="_TaskIcons" model="Model.Icons" />
<h2 class="h4 mt-4">Recent changes</h2>
<div id="person-history">
    @if (Model.History.Count == 0)
    {
        <p class="text-body-secondary">Nothing in the audit log about @p.FullName yet.</p>
    }
    else
    {
        <table class="table table-sm">
            <thead><tr><th>When</th><th>Who</th><th>What</th><th>Result</th></tr></thead>
            <tbody>
                @foreach (var h in Model.History)
                {
                    <tr>
                        <td>@DreamGrid.Launcher.Pages.People.PersonModel.When(h.At)</td>
                        <td>@h.Entry.Actor</td>
                        <td>@h.Entry.Action</td>
                        <td>@h.Entry.Result</td>
                    </tr>
                }
            </tbody>
        </table>
    }
</div>
</text>
}
