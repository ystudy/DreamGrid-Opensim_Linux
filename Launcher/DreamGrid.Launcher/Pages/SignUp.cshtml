@page "/signup"
@model DreamGrid.Launcher.Pages.SignUpModel
@{
    Layout = "_GuestLayout";
    ViewData["Title"] = T["Common.CreateAccount"].Value;
}
<div class="card card-body shadow-sm mx-auto sign-in-card">
<h1>@T["Common.CreateAccount"]</h1>
@if (Model.Closed)
{
    <p>@T["SignUp.Closed"]</p>
    <p class="mb-0">@T.With("SignUp.SignInIfAccount", ResidentHtml.Link("/guest/sign-in", T["Common.SignIn"].Value))</p>
}
else if (Model.CheckEmail)
{
    <p id="sign-up-reply" role="status">@T["SignUp.CheckEmail"]</p>
    <p>@T["SignUp.CantFindEmail"]</p>
    <form id="resend" method="post" asp-page-handler="Resend">
        <input type="hidden" asp-for="First">
        <input type="hidden" asp-for="Last">
        <button type="submit" class="btn btn-outline-primary">@T["SignUp.SendAgain"]</button>
    </form>
    <p class="mt-3 mb-0"><a href="/guest/connect">@T["Common.HowToConnect"]</a></p>
}
else if (Model.WaitingForStaff)
{
    <p id="sign-up-reply" role="status">@T["SignUp.WaitingForStaff"]</p>
    <p class="mb-0"><a href="/guest/sign-in">@T["Common.SignIn"]</a> · <a href="/guest/connect">@T["Common.HowToConnect"]</a></p>
}
else
{
    <p class="tone-text">@T["SignUp.Intro", Model.GridName]</p>
    @if (Model.Error is not null)
    {
        <div class="error-box error alert alert-danger" role="alert">@Model.Error</div>
    }
    var steps = Model.Starters.Count > 0;
    <form id="sign-up" method="post" data-step="1">
        @if (steps)
        {
            <p class="form-text mb-0">@T["SignUp.Step", 1, 2]</p>
        }
        <div id="step1">
        <label class="form-label mt-3" asp-for="First">@T["SignUp.FirstName"]</label>
        <input class="form-control" asp-for="First" maxlength="31" autocomplete="given-name" required>
        <label class="form-label mt-3" asp-for="Last">@T["SignUp.LastName"]</label>
        <input class="form-control" asp-for="Last" maxlength="31" autocomplete="family-name" required>
        <label class="form-label mt-3" asp-for="Email">@T["Common.Email"]</label>
        <input class="form-control" asp-for="Email" type="email" maxlength="254" autocomplete="email" required>
        <label class="form-label mt-3" asp-for="Password">@T["Common.Password"]</label>
        <input class="form-control" asp-for="Password" type="password" value="" autocomplete="new-password" minlength="8" required>
        <label class="form-label mt-3" asp-for="Again">@T["SignUp.PasswordAgain"]</label>
        <input class="form-control" asp-for="Again" type="password" value="" autocomplete="new-password" minlength="8" required>
        <div class="form-check mt-3">
            <input class="form-check-input" type="checkbox" id="AcceptTerms" name="AcceptTerms" value="true" required>
            <label class="form-check-label" for="AcceptTerms">@T.With("SignUp.AcceptTerms", ResidentHtml.Link("/terms", T["SignUp.TermsOfService"].Value), ResidentHtml.Link("/privacy", T["SignUp.PrivacyNotice"].Value))</label>
        </div>
        <partial name="_BotFields" />
        @if (steps)
        {
            <button type="button" id="to-step2" class="btn btn-primary w-100 mt-4" hidden>@T["SignUp.Next"]</button>
        }
        </div>
        @if (steps)
        {
            <fieldset id="step2" class="mt-4">
                <p class="form-text mb-0">@T["SignUp.Step", 2, 2]</p>
                <h2 class="h4 mt-1">@T["SignUp.ChooseAvatar"]</h2>
                <p class="tone-text">@T["SignUp.ChooseAvatarHint"]</p>
                <div class="row row-cols-2 row-cols-md-3 g-3">
                    @foreach (var a in Model.Starters)
                    {
                        var id = "avatar-" + a.Id.ToString("N");
                        <div class="col">
                            <input class="btn-check" type="radio" name="Avatar" id="@id" value="@a.Id" checked="@(a.Id == Model.Selected)">
                            <label class="card h-100 starter-card" for="@id">
                                <img class="card-img-top" src="/starter-avatars/@(a.Id).webp" alt="@a.Name" loading="lazy">
                                <span class="card-body text-center py-2">@a.Name</span>
                            </label>
                        </div>
                    }
                </div>
                <button type="button" id="to-step1" class="btn btn-outline-secondary mt-4" hidden>@T["SignUp.Back"]</button>
                <button type="submit" class="btn btn-primary w-100 mt-3">@T["SignUp.CreateAvatar"]</button>
            </fieldset>
        }
        else
        {
            <button type="submit" class="btn btn-primary w-100 mt-4">@T["SignUp.CreateAvatar"]</button>
        }
    </form>
    @if (steps)
    {
        <script src="/js/signup-steps.js"></script>
    }
    <p class="mt-3 mb-0">@T.With("SignUp.SignInIfAccount", ResidentHtml.Link("/guest/sign-in", T["Common.SignIn"].Value))</p>
}
</div>
