@page "/signup"
@model DreamGrid.Launcher.Pages.SignUpModel
@{
    Layout = "_GuestLayout";
    ViewData["Title"] = "Create an account";
}
<div class="card card-body shadow-sm mx-auto sign-in-card">
<h1>Create an account</h1>
@if (Model.Closed)
{
    <p>This grid isn't open for sign-ups yet.</p>
    <p class="mb-0"><a href="/guest/sign-in">Sign in</a> if you already have an account.</p>
}
else if (Model.CheckEmail)
{
    <p id="sign-up-reply" role="status">Check your email. We sent a link to confirm your account. It works once, for 24 hours. Check your spam folder.</p>
    <form id="resend" method="post" asp-page-handler="Resend">
        <input type="hidden" asp-for="First">
        <input type="hidden" asp-for="Last">
        <button type="submit" class="btn btn-outline-primary">Send it again</button>
    </form>
    <p class="mt-3 mb-0"><a href="/guest/connect">How to connect</a></p>
}
else
{
    <p>Choose a name for your avatar and a password. You'll use them to log in to @Model.GridName.</p>
    @if (Model.Error is not null)
    {
        <div class="error-box error alert alert-danger" role="alert">@Model.Error</div>
    }
    <form id="sign-up" method="post">
        <label class="form-label mt-3" asp-for="First">First name</label>
        <input class="form-control" asp-for="First" maxlength="31" autocomplete="given-name" required>
        <label class="form-label mt-3" asp-for="Last">Last name</label>
        <input class="form-control" asp-for="Last" maxlength="31" autocomplete="family-name" required>
        <label class="form-label mt-3" asp-for="Email">Email</label>
        <input class="form-control" asp-for="Email" type="email" maxlength="254" autocomplete="email" required>
        <label class="form-label mt-3" asp-for="Password">Password</label>
        <input class="form-control" asp-for="Password" type="password" value="" autocomplete="new-password" minlength="8" required>
        <label class="form-label mt-3" asp-for="Again">Password again</label>
        <input class="form-control" asp-for="Again" type="password" value="" autocomplete="new-password" minlength="8" required>
        <div class="form-check mt-3">
            <input class="form-check-input" type="checkbox" id="AcceptTerms" name="AcceptTerms" value="true" required>
            <label class="form-check-label" for="AcceptTerms">I accept the <a href="/terms">Terms of Service</a> and the <a href="/privacy">Privacy notice</a>.</label>
        </div>
        <partial name="_BotFields" />
        <button type="submit" class="btn btn-primary w-100 mt-4">Create my avatar</button>
    </form>
    <p class="mt-3 mb-0"><a href="/guest/sign-in">Sign in</a> if you already have an account.</p>
}
</div>
