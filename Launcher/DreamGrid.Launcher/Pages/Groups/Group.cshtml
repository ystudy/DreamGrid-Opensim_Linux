@page "/groups/group"
@model DreamGrid.Launcher.Pages.Groups.GroupModel
@{
    var g = Model.Group;
    ViewData["Title"] = g?.Name ?? "Group";
    var at = g is null ? "" : $"/groups/group?id={g.Id}";
}
<p><a href="/groups">All groups</a></p>
@if (Model.Error is not null)
{
    <div class="error-box error alert alert-danger" role="alert">@Model.Error</div>
}
@if (Model.Notice is not null)
{
    <div class="ok-box alert alert-success" role="status">@Model.Notice</div>
}
@if (Model.Unavailable || g is null)
{
    <h1>Group</h1>
    <p id="group-unavailable">@DreamGrid.Launcher.Groups.GroupsAdmin.DatabaseDown</p>
}
else
{
    <h1>@g.Name</h1>
    <p>Founded by @g.Founder. @(g.OpenToJoin ? "Anyone can join it in the viewer." : "People join it by invitation.") Changes here can take about a minute to show in the viewer.</p>

    @if (Model.ConfirmRemove is not null)
    {
        <form id="confirm-remove" method="post" action="@at&handler=Remove" asp-antiforgery="true" class="mb-3">
            <input type="hidden" name="member" value="@Model.ConfirmRemove">
            <input type="hidden" name="confirm" value="true">
            <button type="submit" class="btn btn-danger">Remove</button>
            <a class="btn btn-outline-secondary" href="@at">Keep them</a>
        </form>
    }

    <h2 class="mt-4">Name and charter</h2>
    <form id="group-save" method="post" action="@at&handler=Save" asp-antiforgery="true">
        <label class="form-label" for="name">Name</label>
        <input class="form-control" id="name" name="name" value="@(Model.TypedName ?? g.Name)" maxlength="@DreamGrid.Launcher.Core.Groups.GroupRules.MaxName" autocomplete="off">
        <label class="form-label mt-2" for="charter">Charter</label>
        <textarea class="form-control" id="charter" name="charter" rows="5" maxlength="@DreamGrid.Launcher.Core.Groups.GroupRules.MaxCharter">@(Model.TypedCharter ?? g.Charter)</textarea>
        <button type="submit" class="btn btn-primary mt-2">Save</button>
    </form>

    <h2 class="mt-4">Default group</h2>
    @if (Model.IsDefault)
    {
        <p>This is the default group. New residents join it when their sign-up is done. People who leave it aren't put back.</p>
        <div class="d-flex flex-wrap gap-2">
            <form id="add-everyone" method="post" action="@at&handler=Everyone" asp-antiforgery="true">
                <button type="submit" class="btn btn-primary">Add everyone now</button>
            </form>
            <form method="post" action="@at&handler=NoDefault" asp-antiforgery="true">
                <button type="submit" class="btn btn-outline-secondary">Stop being the default</button>
            </form>
        </div>
        <p class="hint form-text">Add everyone now puts in every resident who isn't in it yet, except people who were in it before and left.</p>
    }
    else
    {
        <p>New residents join the default group when their sign-up is done. People who leave it aren't put back.</p>
        <form method="post" action="@at&handler=Default" asp-antiforgery="true">
            <button type="submit" class="btn btn-outline-primary">Make this the default group</button>
        </form>
    }

    <h2 class="mt-4">Members</h2>
    <div class="table-responsive">
        <table id="group-members" class="table align-middle">
            <thead><tr><th>Name</th><th>Roles</th><th></th></tr></thead>
            <tbody>
            @foreach (var m in g.Members)
            {
                <tr>
                    <td>@m.Name</td>
                    <td>@string.Join(", ", m.Roles)</td>
                    <td>
                        <form method="post" action="@at&handler=Remove" asp-antiforgery="true">
                            <input type="hidden" name="member" value="@m.PrincipalId">
                            <button type="submit" class="btn btn-sm btn-outline-danger">Remove</button>
                        </form>
                    </td>
                </tr>
            }
            </tbody>
        </table>
    </div>

    <h3 class="mt-3 h5">Add someone</h3>
    <form id="group-add" method="post" action="@at&handler=Add" asp-antiforgery="true">
        <label class="form-label" for="avatar">Avatar name</label>
        <input class="form-control" id="avatar" name="avatar" value="@Model.TypedAvatar" autocomplete="off" autocapitalize="off" spellcheck="false" placeholder="First Last">
        <p class="hint form-text">A resident of your grid. They're put in at once, with the group's Everyone role. Hypergrid visitors can't be added here.</p>
        <button type="submit" class="btn btn-primary">Add</button>
    </form>

    <h2 class="mt-4">Delete</h2>
    <form id="group-delete" method="post" action="@at&handler=Delete" asp-antiforgery="true">
        <div class="form-check">
            <input class="form-check-input" type="checkbox" id="confirm" name="confirm" value="true">
            <label class="form-check-label" for="confirm">Delete @g.Name and remove its @g.Members.Count members</label>
        </div>
        <button type="submit" class="btn btn-danger mt-2">Delete group</button>
    </form>
}
