@page "/"
@model IndexModel
@{
    ViewData["Title"] = "Your world";
    var g = Model.Status.Grid;
    var parts = new[] { g.Database, g.Robust };
}
<h1>Your world</h1>

<section class="card card-body shadow-sm mb-3">
    <p id="headline" class="headline@(Model.Status.Problem is null ? "" : " problem")">@Model.Status.Headline</p>
    <ul id="components" class="components list-group list-group-flush">
        @foreach (var c in parts)
        {
            <li class="list-group-item px-0">
                <span class="component-label">@c.Label</span>
                <span class="badge state-@c.State.ToLowerInvariant()">@c.StateText</span>
                <span class="text-body-secondary">@c.Detail</span>
            </li>
        }
        @foreach (var r in g.Regions)
        {
            <li class="list-group-item px-0">
                @if (r.Id is { } rid)
                {
                    <a class="component-label" href="/regions?region=@rid">@r.Name</a>
                }
                else
                {
                    <span class="component-label">@r.Name</span>
                }
                <span class="badge state-@r.State.ToLowerInvariant()">@r.StateText</span>
                @if (r.RunsWith is { Count: > 0 } others)
                {
                    <span class="text-body-secondary">runs with @string.Join(", ", others)</span>
                }
            </li>
        }
    </ul>
    @if (Model.FailedLogs.Count > 0)
    {
        <details class="failed-details mt-2">
            <summary>Show details</summary>
            @foreach (var (label, lines) in Model.FailedLogs)
            {
                <p class="component-label">@label</p>
                <pre>@string.Join('\n', lines)</pre>
            }
        </details>
    }
</section>

<section class="card card-body shadow-sm mb-3">
    <h2>Controls</h2>
    <form id="controls" method="post" action="/dashboard?handler=run" asp-antiforgery="true">
        @* The world's power menu (spec 6.8): a <details> element, so it opens without JavaScript. *@
        <details class="power-menu">
            <summary class="btn btn-primary">&#x23FB; Power</summary>
            <div class="power-items list-group shadow">
                <div class="list-group-item">
                    <button type="submit" name="gridAction" value="start" class="btn btn-link p-0 fw-semibold">Start</button>
                    <span class="form-text d-block m-0">Every region except parked ones.</span>
                </div>
                <div class="list-group-item">
                    <button type="submit" name="gridAction" value="start-everything" class="btn btn-link p-0 fw-semibold">Start everything</button>
                    <span class="form-text d-block m-0">Parked regions too; they stop being parked.</span>
                </div>
                <div class="list-group-item">
                    <button type="submit" name="gridAction" value="restart" class="btn btn-link p-0 fw-semibold">Restart</button>
                    <span class="form-text d-block m-0">Every running region@(Model.RunsRobust ? ", the grid service" : "") and the database.</span>
                </div>
                <div class="list-group-item">
                    <button type="submit" name="gridAction" value="stop" class="btn btn-link p-0 fw-semibold">Stop all</button>
                    <span class="form-text d-block m-0">Everything goes offline. Parked regions stay parked.</span>
                </div>
            </div>
        </details>
        <details class="mt-3">
            <summary>More</summary>
            <p class="form-text">Restart one part of your world.</p>
            <div class="d-flex flex-wrap gap-2">
                <button type="submit" name="gridAction" value="restart-database" class="btn btn-sm btn-outline-secondary">Restart the database</button>
                @if (Model.RunsRobust)
                {
                    <button type="submit" name="gridAction" value="restart-robust" class="btn btn-sm btn-outline-secondary">Restart the grid service</button>
                }
            </div>
        </details>
    </form>
    <p id="notice" class="notice alert alert-info mt-3 mb-0 py-2" role="status">@Model.Notice</p>
</section>

<div class="row g-3 mb-3">
<div class="col-md-6">
<section class="card card-body shadow-sm h-100">
    <h2>Who's online</h2>
    <ul id="online" class="online list-unstyled mb-0" hidden="@(Model.Status.Online.Count == 0)">
        @foreach (var name in Model.Status.Online)
        {
            <li>@name</li>
        }
    </ul>
    <p id="online-note" class="text-body-secondary mb-0" hidden="@(Model.Status.Online.Count > 0)">
        @(Model.Status.OnlineAvailable ? "Nobody is in-world right now." : "This list shows once the database is running.")
    </p>
</section>
</div>
<div class="col-md-6">
<section class="card card-body shadow-sm h-100">
    <h2>Connect</h2>
    <p>Your world's address, for the Grid Manager in Firestorm:</p>
    <div class="input-group copy-row">
        <code id="login-uri" class="form-control login-uri">@g.LoginUri</code>
        <button type="button" id="copy-uri" class="btn btn-outline-primary" hidden>Copy</button>
    </div>
</section>
</div>
</div>

@if (Model.Switches.Count > 0)
{
    <section id="features" class="card card-body shadow-sm mb-3">
        <h2>Features</h2>
        <ul class="features list-group list-group-flush">
            @foreach (var (sw, on) in Model.Switches)
            {
                <li class="list-group-item px-0 d-flex flex-wrap align-items-center gap-2">
                    <span class="component-label">@sw.Label</span>
                    <span class="badge@(on ? " state-running" : "")">@(on ? "On" : "Off")</span>
                    <span class="form-text m-0 me-auto">@sw.Description</span>
                    <form method="post" action="/dashboard?handler=switch" asp-antiforgery="true" class="m-0">
                        <input type="hidden" name="moduleId" value="@sw.ModuleId">
                        <button type="submit" name="on" value="@(on ? "false" : "true")" class="btn btn-sm btn-outline-primary">@(on ? "Turn off" : "Turn on")</button>
                    </form>
                </li>
            }
        </ul>
    </section>
}

<section class="card card-body shadow-sm mb-3">
    <h2>Coming soon</h2>
    <p class="text-body-secondary">Your world will grow. These are on the way:</p>
    <ul class="coming-soon list-unstyled d-flex flex-wrap gap-2 mb-0">
        <li>Backups</li>
        <li>SmartStart</li>
        <li>Voice</li>
        <li>Birds</li>
        <li>Tides</li>
    </ul>
</section>

@section Scripts {
<script>
(function () {
    copyButton(document.getElementById("login-uri"), document.getElementById("copy-uri"));

    var form = document.getElementById("controls");
    var notice = document.getElementById("notice");
    var token = form.querySelector("input[name=__RequestVerificationToken]").value;
    // With JavaScript the controls call /api/grid/* and the page stays put; without it the form posts.
    form.addEventListener("submit", function (e) {
        var button = e.submitter;
        if (!button || !window.fetch) return;
        e.preventDefault();
        fetch("/api/grid/" + encodeURIComponent(button.value), {
            method: "POST",
            credentials: "same-origin",
            headers: { RequestVerificationToken: token, Accept: "application/json" }
        })
            .then(function (r) { return r.ok ? r.json() : Promise.reject(r); })
            .then(function (j) { notice.textContent = j.notice; })
            .catch(function () { notice.textContent = "That did not work. Reload the page and try again."; });
    });

    function render(s) {
        // The page was rendered for an admin whose sign-in has since expired.
        if (s.admin === false) { signInAgain(); return; }
        var headline = document.getElementById("headline");
        headline.textContent = s.headline;
        headline.className = "headline" + (s.problem ? " problem" : "");

        var list = document.getElementById("components");
        list.textContent = "";
        function row(spans) {
            var li = document.createElement("li");
            li.className = "list-group-item px-0";
            spans.forEach(function (p) {
                if (!p[1]) return;
                var span = document.createElement(p[2] ? "a" : "span");
                if (p[2]) span.href = p[2];
                span.className = p[0];
                span.textContent = p[1];
                li.appendChild(span);
                li.appendChild(document.createTextNode(" "));
            });
            list.appendChild(li);
        }
        [s.grid.database, s.grid.robust].forEach(function (c) {
            row([["component-label", c.label], ["badge state-" + c.state.toLowerCase(), c.stateText], ["text-body-secondary", c.detail]]);
        });
        s.grid.regions.forEach(function (r) {
            var others = r.runsWith && r.runsWith.length ? "runs with " + r.runsWith.join(", ") : "";
            row([["component-label", r.name, r.id ? "/regions?region=" + encodeURIComponent(r.id) : null], ["badge state-" + r.state.toLowerCase(), r.stateText], ["text-body-secondary", others]]);
        });

        var online = document.getElementById("online");
        var note = document.getElementById("online-note");
        online.textContent = "";
        s.online.forEach(function (name) {
            var li = document.createElement("li");
            li.textContent = name;
            online.appendChild(li);
        });
        online.hidden = s.online.length === 0;
        note.hidden = s.online.length > 0;
        note.textContent = s.onlineAvailable ? "Nobody is in-world right now." : "This list shows once the database is running.";
    }

    poll("/api/status", 5000, render);
})();
</script>
}
