@page "/guest/upload"
@model DreamGrid.Launcher.Pages.Guest.UploadModel
@{
    ViewData["Title"] = T["Upload.Title"].Value;
}
<h1>@T["Upload.Title"]</h1>
@if (Model.Error is not null)
{
    <div class="error-box error alert alert-danger" role="alert">@Model.Error</div>
}
<p>@T.With("Upload.Intro", ResidentHtml.Code(".glb"), ResidentHtml.Code(".gltf"))</p>
<form method="post" action="/guest/upload" enctype="multipart/form-data" asp-antiforgery="true">
    <div class="mb-3">
        <label class="form-label" for="upload-file">@T["Upload.File"]</label>
        <input class="form-control" id="upload-file" type="file" name="File" accept=".glb,.gltf" required>
    </div>
    <div class="mb-3">
        <label class="form-label" for="upload-name">@T["Upload.ItemNameOptional"]</label>
        <input class="form-control" id="upload-name" type="text" name="ItemName" maxlength="63" value="@Model.ItemName">
        <div class="form-text">@T["Upload.ItemNameHelp"]</div>
    </div>
    <button type="submit" class="btn btn-primary">@T["Upload.Check"]</button>
</form>
<p class="mt-3"><a href="/guest/upload/limits">@T["UploadLimits.Title"]</a></p>
<p><a href="/guest">@T["Common.BackToAccount"]</a></p>
