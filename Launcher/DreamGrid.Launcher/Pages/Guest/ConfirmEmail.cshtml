@page "/guest/confirm-email"
@model DreamGrid.Launcher.Pages.Guest.ConfirmEmailModel
@using DreamGrid.Launcher.Guests
@{
    ViewData["Title"] = T["ConfirmEmail.Title"].Value;
}
<div class="card card-body shadow-sm mx-auto sign-in-card">
<h1>@T["ConfirmEmail.Title"]</h1>
@switch (Model.Result)
{
    case EmailLinkResult.Done:
        <p role="status">@T["ConfirmEmail.Done", Model.Email ?? ""]</p>
        break;
    case EmailLinkResult.Taken:
        <p role="alert">@T["ConfirmEmail.Taken"]</p>
        break;
    case EmailLinkResult.Busy:
        <p role="alert">@T["ConfirmEmail.Busy"]</p>
        break;
    default:
        <p role="alert">@T["ConfirmEmail.Expired"]</p>
        break;
}
<p class="mb-0"><a href="/guest/account">@T["ConfirmEmail.ToAccount"]</a></p>
</div>
