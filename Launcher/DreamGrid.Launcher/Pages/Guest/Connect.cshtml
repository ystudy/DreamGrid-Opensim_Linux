@page "/guest/connect"
@model DreamGrid.Launcher.Pages.Guest.ConnectModel
@{
    ViewData["Title"] = T["Connect.Title"].Value;
}
<h1>@T["Connect.Heading", Model.GridName]</h1>
<p class="text-body-secondary">@T["Connect.Choose", Model.GridName]</p>
@if (Model.Approved)
{
    <div class="alert alert-success" role="status">@T["Connect.Approved", Model.DisplayName]</div>
}

<div class="row g-3 mb-3">
    <div class="col-md-6">
        <section id="viewer-firestorm" class="panel h-100">
            <div class="panel-head"><h2>Firestorm</h2><span class="badge state-running">@T["Connect.Recommended"]</span></div>
            <ul class="panel-rows">
                <li><span>@T["Connect.FirestormSystems"]</span><a class="ms-auto" href="@ConnectModel.Firestorm.Url" rel="noopener noreferrer">@T["Connect.Download"]</a></li>
            </ul>
            <p class="form-text mb-0">@T["Connect.FirestormNote"]</p>
        </section>
    </div>
    <div class="col-md-6">
        <section id="viewer-others" class="panel h-100">
            <div class="panel-head"><h2>@T["Connect.OtherViewers"]</h2><span class="form-text m-0">@T["Connect.AnyViewer"]</span></div>
            <ul class="panel-rows">
                @foreach (var v in ConnectModel.Others)
                {
                    <li><span>@v.Name</span><a class="ms-auto" href="@v.Url" rel="noopener noreferrer">@T["Connect.Website"]</a></li>
                }
            </ul>
            <p class="form-text mb-0">@T["Connect.OthersNote"]</p>
        </section>
    </div>
</div>

<section id="grid-settings-panel" class="panel mb-3">
    <div class="panel-head"><h2>@T["Connect.GridSettings"]</h2><button type="button" id="copy-settings" class="btn btn-sm btn-outline-primary" hidden data-copied="@T["Connect.Copied"]" data-selected="@T["Connect.CopySelected"]">@T["Connect.Copy"]</button></div>
    <pre id="grid-settings" class="panel-pre">@Model.SettingsText()</pre>
    <p class="form-text mb-0">@T["Connect.SettingsNote"]</p>
</section>

<div class="row g-3 mb-3">
    <div class="col-md-6">
        <section id="steps" class="panel h-100">
            <div class="panel-head"><h2>@T["Connect.Steps"]</h2></div>
            <ol class="steps mb-0">
                <li>@T["Connect.Step1"]</li>
                <li>@T["Connect.Step2"] <code id="login-uri">@Model.LoginUri</code></li>
                <li>@T["Connect.Step3", Model.GridName]</li>
                @if (Model.DisplayName.Length > 0)
                {
                    <li>@T["Connect.Step4Named", Model.DisplayName]</li>
                }
                else
                {
                    <li>@T["Connect.Step4"]</li>
                }
            </ol>
        </section>
    </div>
    <div class="col-md-6">
        <section id="help" class="panel h-100">
            <div class="panel-head"><h2>@T["Connect.Help"]</h2></div>
            <ul class="panel-rows">
                <li><a href="@ConnectModel.FirestormHelp" rel="noopener noreferrer">@T["Connect.FirestormHelp"]</a></li>
                @if (Model.DisplayName.Length == 0)
                {
                    <li><a href="/signup">@T["Connect.MakeAccount"]</a></li>
                }
                <li><a href="/guest/forgot-password">@T["Connect.ForgotPassword"]</a></li>
                <li><a href="/support">@T["Connect.AskStaff"]</a></li>
                @foreach (var (id, title) in Model.HelpPages)
                {
                    <li><a href="/@id">@(id switch { "terms" => T["Connect.HelpTerms"].Value, "contact" => T["Connect.HelpContact"].Value, _ => title })</a></li>
                }
            </ul>
        </section>
    </div>
</div>
<p class="text-body-secondary text-center small">@T["Connect.NoSupport", Model.GridName]</p>

@section Scripts {
<script src="/js/connect.js"></script>
}
