@page "/guest/reset-password"
@model DreamGrid.Launcher.Pages.Guest.ResetPasswordModel
@{
    ViewData["Title"] = "Choose a new password";
}
<div class="card card-body shadow-sm mx-auto sign-in-card">
<h1>Choose a new password</h1>
@if (Model.SignInAt is not null)
{
    <p id="reset-done" role="status">Your password is changed. Sign in with your new password.</p>
    <p class="mb-0"><a id="reset-done-link" class="btn btn-primary" href="@Model.SignInAt">Sign in</a></p>
}
else if (Model.Expired)
{
    <p id="reset-expired">This link has expired or was already used. Ask for a new one.</p>
    <p class="mb-0"><a href="/guest/forgot-password">Ask for a new link</a></p>
}
else
{
    <p>For @Model.Name. Use at least 8 characters.</p>
    @if (Model.Error is not null)
    {
        <div class="error-box error alert alert-danger" role="alert">@Model.Error</div>
    }
    <form id="reset" method="post" action="/guest/reset-password" asp-antiforgery="true">
        <input type="hidden" name="Token" value="@Model.Token">
        @if (Model.NeedsCode)
        {
            <label class="form-label mt-3" for="reset-code">Code from your authenticator app, or a backup code</label>
            <input class="form-control" id="reset-code" name="Code" value="" maxlength="32" autocomplete="one-time-code" required>
        }
        <label class="form-label mt-3" for="reset-password">New password</label>
        <input class="form-control" id="reset-password" name="Password" type="password" value="" maxlength="256" autocomplete="new-password" required>
        <label class="form-label mt-3" for="reset-again">New password again</label>
        <input class="form-control" id="reset-again" name="Again" type="password" value="" maxlength="256" autocomplete="new-password" required>
        <button type="submit" class="btn btn-primary w-100 mt-4">Change password</button>
    </form>
}
</div>
