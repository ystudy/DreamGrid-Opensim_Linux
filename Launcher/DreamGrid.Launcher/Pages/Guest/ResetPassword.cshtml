@page "/guest/reset-password"
@model DreamGrid.Launcher.Pages.Guest.ResetPasswordModel
@using DreamGrid.Launcher.Core.Security
@{
    ViewData["Title"] = T["ResetPassword.Title"].Value;
}
<div class="card card-body shadow-sm mx-auto sign-in-card">
<h1>@T["ResetPassword.Title"]</h1>
@if (Model.SignInAt is not null)
{
    <p id="reset-done" role="status">@T["ResetPassword.Done"]</p>
    <p class="mb-0"><a id="reset-done-link" class="btn btn-primary" href="@Model.SignInAt">@T["SignIn.Button"]</a></p>
}
else if (Model.Expired)
{
    <p id="reset-expired">@T["ResetPassword.Expired"]</p>
    <p class="mb-0"><a href="/guest/forgot-password">@T["ResetPassword.AskNew"]</a></p>
}
else
{
    <p>@T["ResetPassword.Intro", Model.Name ?? "", PasswordRules.MinLength]</p>
    @if (Model.Error is not null)
    {
        <div class="error-box error alert alert-danger" role="alert">@Model.Error</div>
    }
    <form id="reset" method="post" action="/guest/reset-password" asp-antiforgery="true">
        <input type="hidden" name="Token" value="@Model.Token">
        @if (Model.NeedsCode)
        {
            <label class="form-label mt-3" for="reset-code">@T["ResetPassword.CodeLabel"]</label>
            <input class="form-control" id="reset-code" name="Code" value="" maxlength="32" autocomplete="one-time-code" required>
        }
        <label class="form-label mt-3" for="reset-password">@T["ResetPassword.NewPassword"]</label>
        <input class="form-control" id="reset-password" name="Password" type="password" value="" maxlength="256" autocomplete="new-password" required>
        <label class="form-label mt-3" for="reset-again">@T["ResetPassword.NewPasswordAgain"]</label>
        <input class="form-control" id="reset-again" name="Again" type="password" value="" maxlength="256" autocomplete="new-password" required>
        <button type="submit" class="btn btn-primary w-100 mt-4">@T["ResetPassword.Change"]</button>
    </form>
}
</div>
