@page "/guest/forgot-password"
@model DreamGrid.Launcher.Pages.Guest.ForgotPasswordModel
@{
    ViewData["Title"] = "Forgot password";
}
<div class="card card-body shadow-sm mx-auto sign-in-card">
<h1>Forgot password</h1>
@if (Model.Off)
{
    <p id="reset-off">Password reset isn't turned on for this grid. Contact the grid owner.</p>
}
else if (Model.Sent)
{
    <p id="reset-reply" role="status">If that name and email match an account, we've sent a link. It works once, for 30 minutes. Check your spam folder.</p>
    <p class="mb-0"><a href="/guest/sign-in">Back to sign in</a></p>
}
else
{
    <p>Type your avatar name and the email address on your account. We'll email you a link to choose a new password.</p>
    @if (Model.Error is not null)
    {
        <div class="error-box error alert alert-danger" role="alert">@Model.Error</div>
    }
    <form id="forgot" method="post">
        <label class="form-label mt-3" asp-for="Name">Avatar name</label>
        <input class="form-control" asp-for="Name" maxlength="64" autocomplete="username" placeholder="First Last" required>
        <label class="form-label mt-3" asp-for="Email">Email</label>
        <input class="form-control" asp-for="Email" type="email" maxlength="254" autocomplete="email" required>
        <partial name="_BotFields" />
        <button type="submit" class="btn btn-primary w-100 mt-4">Send the link</button>
    </form>
    <p class="mt-3 mb-0"><a href="/guest/sign-in">Back to sign in</a></p>
}
</div>
