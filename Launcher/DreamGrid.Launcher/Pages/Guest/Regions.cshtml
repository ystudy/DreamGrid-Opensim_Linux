@page "/guest/regions"
@model DreamGrid.Launcher.Pages.Guest.MyRegionsModel
@{
    ViewData["Title"] = T["Regions.Title"].Value;
}
<h1>@T["Regions.Title"]</h1>
@if (Model.Notice is not null)
{
    <p class="notice alert alert-info py-2" role="status">@Model.Notice</p>
}
@if (Model.Regions.Count == 0)
{
    <p>@T["Regions.None"]</p>
}
else
{
    <p class="text-body-secondary">@T["Regions.RestartInWorld"]</p>
    @foreach (var region in Model.Regions)
    {
        <section class="card mb-3" id="region-@region.Id">
            <div class="card-body">
                <h2 class="h5 card-title">@region.Name</h2>
                <p class="mb-1 region-state">@T["Regions.State", region.State]</p>
                <p class="mb-1">@T["Regions.PeopleHere", region.PeopleHere]</p>
                <p class="mb-2">@region.LastStarted</p>
                @if (region.Restart.Shown)
                {
                    <form method="post" action="/guest/regions?handler=restart" asp-antiforgery="true">
                        <input type="hidden" name="id" value="@region.Id">
                        <button type="submit" class="btn btn-outline-primary" disabled="@(!region.Restart.Allowed)">@(region.Restart.Action == DreamGrid.Launcher.Core.Grid.RegionPower.Start ? T["Regions.Start"].Value : T["Regions.Restart"].Value)</button>
                    </form>
                    @if (region.RestartReason is not null)
                    {
                        <p class="restart-reason text-body-secondary mt-2 mb-0">@region.RestartReason</p>
                    }
                }
            </div>
        </section>
    }
}
<p><a href="/guest">@T["Common.BackToAccount"]</a></p>
