@page "/guest/upload/{job}"
@model DreamGrid.Launcher.Pages.Guest.UploadReportModel
@using DreamGrid.Launcher.Pages.Guest
@{
    ViewData["Title"] = Model.DoneItem is not null ? "Item made" : "Check report";
}
@functions {
    private static string Css(ReportLine line) => "finding finding-" + line.Finding.Code;
}
@if (Model.Failed)
{
    <h1>Upload a model</h1>
    <div class="error-box error alert alert-danger" role="alert">@UploadReportModel.NothingCharged</div>
    <p><a href="/guest/upload">Upload a model</a></p>
}
else if (Model.DoneItem is not null)
{
    <h1>Item made</h1>
    <p class="done alert alert-success" role="status">@Model.DoneItem is in your inventory, in the Uploads folder. If you're logged in, log out and back in to see it.</p>
    <p><a href="/guest/upload">Upload another</a></p>
}
else if (Model.AlreadyFinished)
{
    <h1>Upload a model</h1>
    <p class="notice alert alert-info" role="status">This upload is already finished.</p>
    <p><a href="/guest/upload">Upload another</a></p>
}
else
{
    <h1>Check report</h1>
}
@if (Model.Notice is not null && !Model.Failed && Model.DoneItem is null)
{
    <p class="notice alert alert-info py-2" role="status">@Model.Notice</p>
}
@if (Model.Error is not null)
{
    <div class="error-box error alert alert-danger" role="alert">@Model.Error</div>
}
@if (Model.Report is not null && !Model.AlreadyFinished)
{
    <p class="report-heading lead">@Model.Heading()</p>

    @if (Model.Risky.Count > 0)
    {
        <div class="warning-box alert alert-warning" role="alert">
            <p class="warning-heading"><strong>@Model.Item may look distorted or shaped wrong.</strong> You should correct:</p>
            <ol class="mb-0">
                @foreach (var line in Model.Risky)
                {
                    <li class="@Css(line)"><strong>@line.Text.Title.</strong> @line.Text.Why <span class="tip text-body-secondary">@line.Text.Tip</span></li>
                }
            </ol>
        </div>
    }

    var editable = Model.DoneItem is null && Model.Current is not null;
    var tooBig = Model.Blocking.FirstOrDefault(l => l.Finding.Code == "too-big");

    void Findings()
    {
        @foreach (var line in Model.Blocking)
        {
            <div class="blocking alert alert-danger">
                <div class="@Css(line)">
                    <p class="mb-1"><strong>@line.Text.Title.</strong> @line.Text.Why</p>
                    <p class="tip mb-1">@line.Text.Tip</p>
                    @if (editable && line == tooBig)
                    {
                        var offered = Model.OfferedScale(line.Finding);
                        <label class="form-label" for="upload-scale">Size, in percent</label>
                        <input class="form-control w-auto d-inline-block" id="upload-scale" type="number" name="ScalePercent"
                               min="@UploadReportModel.MinScale" max="@UploadReportModel.MaxScale" value="@offered">
                        <p class="form-text mb-0">@offered% is the largest size that fits on this grid.</p>
                    }
                </div>
            </div>
        }
        @if (Model.Safe.Count > 0)
        {
            <h2 class="h5">Fixed for you</h2>
            <ul class="safe-fixes">
                @foreach (var line in Model.Safe)
                {
                    <li class="@Css(line)">@line.Text.Title @line.Text.Why <span class="tip text-body-secondary">@line.Text.Tip</span></li>
                }
            </ul>
        }
    }

    @if (!editable)
    {
        Findings();
    }
    else
    {
        <form class="upload-report" method="post" action="/guest/upload/@Model.Job?handler=Rescale" asp-antiforgery="true">
            @{ Findings(); }
            @if (tooBig is null)
            {
                <input type="hidden" name="ScalePercent" value="@Model.ScalePercent">
            }
            <div class="mb-3">
                <label class="form-label" for="report-name">Item name</label>
                <input class="form-control" id="report-name" type="text" name="ItemName" maxlength="63" value="@Model.ItemName">
            </div>
            <fieldset class="mb-3">
                <legend class="h6">The next owner may</legend>
                <div class="form-check form-check-inline">
                    <input class="form-check-input" id="next-copy" type="checkbox" name="Copy" value="true" checked="@Model.Copy">
                    <label class="form-check-label" for="next-copy">Copy</label>
                </div>
                <div class="form-check form-check-inline">
                    <input class="form-check-input" id="next-modify" type="checkbox" name="Modify" value="true" checked="@Model.Modify">
                    <label class="form-check-label" for="next-modify">Modify</label>
                </div>
                <div class="form-check form-check-inline">
                    <input class="form-check-input" id="next-transfer" type="checkbox" name="Transfer" value="true" checked="@Model.Transfer">
                    <label class="form-check-label" for="next-transfer">Transfer</label>
                </div>
            </fieldset>
            <button type="submit" class="btn btn-outline-primary check-again">Check again</button>
            @if (!Model.Report.Blocked)
            {
                <button type="submit" class="btn btn-primary make-item" formaction="/guest/upload/@Model.Job?handler=Make">Make the item</button>
            }
        </form>
        @if (Model.Report.Blocked)
        {
            <p class="mt-3"><a href="/guest/upload">Upload a different file</a></p>
        }
    }
}
<p class="mt-3"><a href="/guest/upload/limits">Limits on this grid</a></p>
<p><a href="/guest">Back to your account</a></p>
