@page "/guest/confirm"
@model DreamGrid.Launcher.Pages.Guest.ConfirmModel
@{
    ViewData["Title"] = T["Confirm.Title"].Value;
}
<div class="card card-body shadow-sm mx-auto sign-in-card">
<h1>@T["Confirm.Title"]</h1>
@if (Model.Busy)
{
    <p role="alert">@T["Common.SignUpBusy"]</p>
}
else if (Model.AlreadyApproved)
{
    <p role="status">@T["Confirm.AlreadyApproved"] <a href="/guest/sign-in">@T["Confirm.SignInLink"]</a></p>
}
else
{
    <p role="alert">@T["Confirm.Expired"]</p>
    <p class="mb-0"><a href="/signup">@T["Confirm.SignUpAgain"]</a> · <a href="/guest/sign-in">@T["Confirm.SignInForNewLink"]</a></p>
}
</div>
