@page "/guest/sign-in"
@model DreamGrid.Launcher.Pages.Guest.SignInModel
@{
    ViewData["Title"] = T["Common.SignIn"].Value;
}
<div class="card card-body shadow-sm mx-auto sign-in-card">
<h1>@T["Common.SignIn"]</h1>
<p>@T["SignIn.Intro"]</p>
@if (Model.Error is not null)
{
    <div class="error-box error alert alert-danger" role="alert">@Model.Error</div>
}
<form method="post">
    <label class="form-label mt-3" asp-for="Name">@T["Common.AvatarName"]</label>
    <input class="form-control" asp-for="Name" maxlength="64" autocomplete="username" placeholder="@T["Common.NamePlaceholder"]" required>
    <label class="form-label mt-3" asp-for="Password">@T["Common.Password"]</label>
    <input class="form-control" asp-for="Password" type="password" value="" autocomplete="current-password" required>
    <button type="submit" class="btn btn-primary w-100 mt-4">@T["Common.SignIn"]</button>
</form>
@if (Model.Pending is { } pending)
{
    <form id="resend" method="post" action="/signup?handler=Resend" asp-antiforgery="true" class="mt-3">
        <input type="hidden" name="First" value="@pending.FirstName">
        <input type="hidden" name="Last" value="@pending.LastName">
        <button type="submit" class="btn btn-outline-primary w-100">@T["SignIn.ResendLink"]</button>
    </form>
}
@if (Model.ShowForgot)
{
    <p class="mt-3 mb-0"><a href="/guest/forgot-password">@T["Common.ForgotPasswordLink"]</a> · <a href="/support">@T["SignIn.CantSignIn"]</a></p>
}
@if (Model.ShowSignUp)
{
    <p class="mt-2 mb-0"><a href="/signup">@T["Common.CreateAccount"]</a></p>
}
</div>
