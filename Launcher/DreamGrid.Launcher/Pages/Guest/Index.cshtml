@page "/guest"
@model DreamGrid.Launcher.Pages.Guest.IndexModel
@{
    ViewData["Title"] = T["Guest.Title"].Value;
}
<h1>@Model.GridName</h1>
<p>@T["Guest.SignedInAs", Model.DisplayName]</p>

<h2>@T["Guest.ConnectHeading"]</h2>
<ol>
    <li>@T.With("Guest.Step1", ResidentHtml.Link("https://www.firestormviewer.org/downloads/", "https://www.firestormviewer.org/downloads/"))</li>
    <li>@T["Guest.Step2"]</li>
    <li>@T.With("Guest.Step3", ResidentHtml.Code(Model.LoginUri))</li>
    <li>@T["Guest.Step4", Model.GridName]</li>
</ol>

<p><a href="/guest/connect">@T["Common.HowToConnect"]</a></p>
<p><a href="/guest/account">@T["Account.Title"]</a></p>

@if (Model.OwnsRegions)
{
    <p><a href="/guest/regions">@T["Regions.Title"]</a></p>
}
@if (Model.UploadLink)
{
    <p><a href="/guest/upload">@T["Upload.Title"]</a></p>
}
@if (Model.TwoFactorLink)
{
    <p><a href="/guest/two-factor">@T["Common.TwoFactorSignIn"]</a></p>
}

<form method="post" action="/guest/sign-out" asp-antiforgery="true">
    <button type="submit" class="btn btn-outline-secondary">@T["Guest.SignOut"]</button>
</form>
