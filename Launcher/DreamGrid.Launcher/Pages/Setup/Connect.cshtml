@page "/setup/connect"
@model DreamGrid.Launcher.Pages.Setup.ConnectModel
@{
    ViewData["Title"] = "Connect with Firestorm";
}
<partial name="_Checklist" />
<h1>Connect with Firestorm</h1>
<p>Your world's address:</p>
<div class="input-group copy-row mb-3">
    <code id="login-uri" class="form-control login-uri">@Model.LoginUri</code>
    <button type="button" id="copy-uri" class="btn btn-outline-primary" hidden>Copy</button>
</div>
<ol class="steps list-group list-group-numbered mb-3">
    <li class="list-group-item">Install Firestorm from <a href="https://www.firestormviewer.org/" rel="noopener noreferrer" target="_blank">https://www.firestormviewer.org/</a></li>
    <li class="list-group-item">Viewer → Preferences → OpenSim → Grid Manager → paste the address → Apply</li>
    <li class="list-group-item">Pick @Model.GridName on the login screen</li>
    <li class="list-group-item">Log in as @Model.OwnerName</li>
</ol>
<form method="post">
    <button type="submit" class="btn btn-primary mt-3">I'm in!</button>
</form>

@section Scripts {
<script>
copyButton(document.getElementById("login-uri"), document.getElementById("copy-uri"));
</script>
}
