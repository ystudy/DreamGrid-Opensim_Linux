@page "/setup/connect"
@model DreamGrid.Launcher.Pages.Setup.ConnectModel
@{
    ViewData["Title"] = "Connect with Firestorm";
}
<partial name="_Checklist" model="4" />
<h1>Connect with Firestorm</h1>
<p>Your world's address:</p>
<div class="copy-row">
    <code id="login-uri" class="login-uri">@Model.LoginUri</code>
    <button type="button" id="copy-uri" hidden>Copy</button>
</div>
<ol class="steps">
    <li>Install Firestorm from <a href="https://www.firestormviewer.org/" rel="noopener noreferrer" target="_blank">https://www.firestormviewer.org/</a></li>
    <li>Viewer → Preferences → OpenSim → Grid Manager → paste the address → Apply</li>
    <li>Pick @Model.GridName on the login screen</li>
    <li>Log in as @Model.OwnerName</li>
</ol>
<form method="post">
    <button type="submit">I'm in!</button>
</form>

@section Scripts {
<script>
(function () {
    var uri = document.getElementById("login-uri");
    var button = document.getElementById("copy-uri");
    function selectAddress() {
        var range = document.createRange();
        range.selectNodeContents(uri);
        var sel = window.getSelection();
        sel.removeAllRanges();
        sel.addRange(range);
    }
    button.hidden = false;
    button.addEventListener("click", function () {
        // The clipboard API needs a secure context (localhost); elsewhere the address is selected for Ctrl+C.
        if (navigator.clipboard && window.isSecureContext) {
            navigator.clipboard.writeText(uri.textContent).then(function () { button.textContent = "Copied"; }, selectAddress);
        } else {
            selectAddress();
            button.textContent = "Selected: press Ctrl+C";
        }
    });
})();
</script>
}
