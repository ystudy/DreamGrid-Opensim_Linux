@page "/setup/region"
@model DreamGrid.Launcher.Pages.Setup.RegionModel
@{
    ViewData["Title"] = "Choose your first region";
    var p = Model.Progress;
}
@section Head {
    @if (p.Running)
    {
        @* Without JavaScript the page reloads itself; with it, the progress is polled instead. *@
        <noscript><meta http-equiv="refresh" content="3"></noscript>
    }
}
<partial name="_Checklist" />
<h1>Choose your first region</h1>

@if (p.Running)
{
    <div class="progress-box alert alert-info" id="setup-progress">
        <p>Setting up your region. This can take a few minutes; you can leave this page open.</p>
        <p class="stage" id="setup-stage">@(p.Stage == "" ? "Getting ready" : p.Stage)…</p>
        <progress id="setup-bar" max="100" value="@p.Percent">@p.Percent %</progress>
    </div>
}
else if (Model.Ready)
{
    <div class="ok-box alert alert-success">
        <p>Your region is ready.</p>
        <a class="button btn btn-primary" href="/setup/connect">Continue</a>
    </div>
}
else if (Model.ShowProgress && p.Error is not null)
{
    <div class="error-box alert alert-danger">
        <p>@p.Error</p>
        @if (p.LogExcerpt is not null)
        {
            <details><summary>Show details</summary><pre class="log-lines">@p.LogExcerpt</pre></details>
        }
        <p>You can change the choices below and try again.</p>
    </div>
}

@if (Model.ShowForm)
{
    @if (Model.CanSkip)
    {
        <div class="skip-region alert alert-secondary">
            <p>A Grid Asset Server doesn't need regions of its own. Other computers can add them. You can run regions here too, but it isn't advised: busy regions slow down logins, inventory and the map for everyone on the grid.</p>
            <form method="post" asp-page-handler="Skip">
                <button type="submit" class="btn btn-outline-primary">Skip: no regions on this computer</button>
            </form>
        </div>
    }
    <form method="post">
        <label class="form-label mt-3" asp-for="RegionName">Region name</label>
        <input class="form-control" asp-for="RegionName" maxlength="32" autocomplete="off" required>
        <span asp-validation-for="RegionName" class="field-error text-danger small d-block"></span>

        <fieldset class="mt-3">
            <legend class="fs-6 fw-semibold">What should it look like?</legend>
            @if (Model.StarterAvailable)
            {
                <div class="form-check"><label class="choice form-check-label"><input class="form-check-input" type="radio" name="Content" value="starter" checked="@(Model.RegionContent == "starter")"> Starter island (trees, greenery and an info kiosk)</label></div>
            }
            <div class="form-check"><label class="choice form-check-label"><input class="form-check-input" type="radio" name="Content" value="island" checked="@(Model.RegionContent == "island")"> Empty island</label></div>
            <span asp-validation-for="RegionContent" class="field-error text-danger small d-block"></span>
        </fieldset>
        <button type="submit" class="btn btn-primary mt-3">Create my region</button>
    </form>
}

@section Scripts {
@if (p.Running)
{
    <script src="/js/setup-region.js"></script>
}
}
