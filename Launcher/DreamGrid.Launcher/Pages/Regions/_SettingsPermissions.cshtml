@model DreamGrid.Launcher.Pages.Regions.SettingsModel
@{
    void Box(string name, string text, bool on)
    {
        <div class="form-check mt-2">
            <input class="form-check-input" type="checkbox" id="@name" name="@name" value="true" checked="@on">
            <label class="form-check-label" for="@name">@text</label>
        </div>
    }
}
<form method="post" action="/regions/region/@Model.Id/settings/permissions?handler=permissions" asp-antiforgery="true">
    <span class="field-error text-danger small d-block">@Model.Error("")</span>
    <fieldset class="mt-3">
        <legend class="fs-6 fw-semibold">Who can use god powers</legend>
        @{ Box("AllowGods", "Allow god powers", Model.AllowGods); }
        @{ Box("OwnerIsGod", "The region owner is a god", Model.OwnerIsGod); }
        @{ Box("ManagerIsGod", "Estate managers are gods", Model.ManagerIsGod); }
    </fieldset>
    <button type="submit" class="btn btn-primary mt-3">Save</button>
    <a class="btn btn-outline-secondary mt-3" href="/regions/region/@Model.Id">Cancel</a>
</form>
