@model DreamGrid.Launcher.Pages.Regions.SettingsModel
<dl class="region-facts mt-3">
    <dt>Name</dt>
    <dd>@Model.Name</dd>
    <dt>Size</dt>
    <dd>@Model.Size×@Model.Size</dd>
    <dt>Map position</dt>
    <dd>@Model.X, @Model.Y</dd>
    <dt>UUID</dt>
    <dd><code>@Model.Id</code></dd>
</dl>
