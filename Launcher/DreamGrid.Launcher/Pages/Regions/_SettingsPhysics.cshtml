@model DreamGrid.Launcher.Pages.Regions.SettingsModel
@{
    var defaultLabel = Model.DefaultPhysics == "BulletSimThreaded" ? "BulletSim in its own thread" : Model.DefaultPhysics;
    (string Value, string Text)[] choices =
    [
        ("", "Grid default (" + defaultLabel + ")"), ("ubODE", "ubODE"), ("BulletSim", "BulletSim"), ("BulletSimThreaded", "BulletSim in its own thread"),
    ];
}
<form method="post" action="/regions/region/@Model.Id/settings/physics?handler=physics" asp-antiforgery="true">
    <span class="field-error text-danger small d-block">@Model.Error("")</span>
    <fieldset class="mt-3">
        <legend class="fs-6 fw-semibold">Physics engine</legend>
        @foreach (var (value, text) in choices)
        {
            var id = "Physics-" + (value == "" ? "default" : value);
            <div class="form-check">
                <input class="form-check-input" type="radio" name="Physics" id="@id" value="@value" checked="@(Model.Physics == value)">
                <label class="form-check-label" for="@id">@text</label>
            </div>
        }
        <span class="field-error text-danger small d-block" data-error-for="Physics">@Model.Error("Physics")</span>
    </fieldset>
    <button type="submit" class="btn btn-primary mt-3">Save</button>
    <a class="btn btn-outline-secondary mt-3" href="/regions/region/@Model.Id">Cancel</a>
</form>
