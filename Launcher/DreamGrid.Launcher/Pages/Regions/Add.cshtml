@page "/regions/add"
@model DreamGrid.Launcher.Pages.Regions.AddModel
@using System.Text.Json
@{
    ViewData["Title"] = "Add a region";
    var p = Model.Progress;
    string Error(string key) => ModelState.TryGetValue(key, out var e) && e.Errors.Count > 0 ? e.Errors[0].ErrorMessage : "";
}
@section Head {
    @if (Model.Running)
    {
        @* Without JavaScript the page reloads itself; with it, the progress is polled instead. *@
        <noscript><meta http-equiv="refresh" content="3"></noscript>
    }
}
<h1>Add a region</h1>

@if (Model.Running)
{
    <div class="progress-box alert alert-info" id="add-progress">
        <p>Adding @(Model.JobName ?? "your region"). This can take a few minutes; you can leave this page open.</p>
        <p class="stage" id="add-stage">@(p.Stage == "" ? "Getting ready" : p.Stage)…</p>
        <progress id="add-bar" max="100" value="@p.Percent">@p.Percent %</progress>
    </div>
}
else if (Model.Ready)
{
    <div class="ok-box alert alert-success">
        <p>@Model.JobName is ready.</p>
        @if (Model.SavedId is { } readyId)
        {
            <a class="show-on-map button btn btn-primary" href="/regions?region=@readyId">Show it on the map</a>
        }
        <a class="btn btn-outline-secondary" href="/regions/add">Add another region</a>
    </div>
}
else if (Model.Failed)
{
    <div class="error-box alert alert-danger">
        <p>@p.Error</p>
        @if (p.LogExcerpt is not null)
        {
            <details><summary>Show details</summary><pre class="log-lines">@p.LogExcerpt</pre></details>
        }
        @if (Model.SavedId is { } failedId)
        {
            @if (Model.ContentLoaded)
            {
                <p>@Model.JobName is saved. Open it to start it again.</p>
            }
            else
            {
                <p>@Model.JobName is saved, but its land wasn't made. Starting it from its page brings it up as plain land.</p>
            }
            <a class="open-region button btn btn-primary" href="/regions?region=@failedId">Open @Model.JobName</a>
        }
        else
        {
            <p>You can change the choices below and try again.</p>
        }
    </div>
}

@if (Model.WorldStopped)
{
    <div class="error-box alert alert-danger">
        <p>Start your world first: the grid service isn't running.</p>
        <a class="btn btn-primary" href="/">Go to the dashboard</a>
    </div>
}

@if (Model.ShowForm)
{
    <form method="post" id="add-form" data-placement="/api/regions/placement" data-risk="@JsonSerializer.Serialize(Model.RiskBySize)">
        <label class="form-label mt-3" for="Name">Region name</label>
        <input class="form-control" id="Name" name="Name" value="@Model.Name" maxlength="32" autocomplete="off" required>
        <span class="field-error text-danger small d-block">@Error("Name")</span>

        <fieldset class="mt-3">
            <legend class="fs-6 fw-semibold">What should it look like?</legend>
            <div class="d-flex flex-wrap gap-3">
                @foreach (var t in Model.Types)
                {
                    <div class="form-check type-choice">
                        <label class="choice form-check-label d-flex align-items-center gap-2">
                            <input class="form-check-input" type="radio" name="Type" value="@t.Id" checked="@(Model.Type == t.Id)">
                            <span class="type-swatch type-@t.Id"><img src="/regions/types/@(t.Id).png" alt="" onerror="this.remove()"></span>
                            <span><span class="type-name fw-semibold">@t.Name</span><span class="type-description form-text d-block m-0">@t.Description</span></span>
                        </label>
                    </div>
                }
            </div>
            <span class="field-error text-danger small d-block">@Error("Type")</span>
        </fieldset>

        <fieldset class="mt-3">
            <legend class="fs-6 fw-semibold">Map position</legend>
            <div class="d-flex flex-wrap gap-3">
                <div>
                    <label class="form-label" for="X">X</label>
                    <input class="form-control" id="X" name="X" type="number" min="0" max="65535" value="@Model.X" required>
                </div>
                <div>
                    <label class="form-label" for="Y">Y</label>
                    <input class="form-control" id="Y" name="Y" type="number" min="0" max="65535" value="@Model.Y" required>
                </div>
            </div>
            <p class="form-text mb-0" id="placement-text" role="status">@Model.PlacementText</p>
            <span class="field-error text-danger small d-block">@Error("X")</span>
        </fieldset>

        <div class="mt-3">
            <label class="form-label fw-semibold" for="Size">Size</label>
            <select class="form-select w-auto" id="Size" name="Size">
                @for (var n = 1; n <= 16; n++)
                {
                    <option value="@n" selected="@(Model.Size == n.ToString())">@n×@n</option>
                }
            </select>
            <p class="form-text mb-0" id="size-risk" role="status">@Model.SizeRisk</p>
            <span class="field-error text-danger small d-block">@Error("Size")</span>
        </div>

        <partial name="_RunsChoices" model="Model.Choices" />

        <button type="submit" class="btn btn-primary mt-3">Add region</button>
    </form>
}

@section Scripts {
@if (Model.Running)
{
    <script>
    (function () {
        var stage = document.getElementById("add-stage");
        var bar = document.getElementById("add-bar");
        poll("/api/regions/progress", 2000, function (s) {
            if (!s.running) {
                // Finished or failed: the page itself shows the result.
                window.location.replace("/regions/add?working=1");
                return;
            }
            stage.textContent = (s.stage || "Getting ready") + "…";
            bar.value = s.percent;
            bar.textContent = s.percent + " %";
        });
    })();
    </script>
}
else if (Model.ShowForm)
{
    <script>
    (function () {
        var form = document.getElementById("add-form");
        var risks = JSON.parse(form.dataset.risk);
        var text = document.getElementById("placement-text");
        var risk = document.getElementById("size-risk");
        var x = document.getElementById("X"), y = document.getElementById("Y"), size = document.getElementById("Size");
        var timer = null;

        function refresh() {
            risk.textContent = risks[size.value - 1] || "";
            if (x.value === "" || y.value === "") { text.textContent = ""; return; }
            clearTimeout(timer);
            timer = setTimeout(function () {
                fetch(form.dataset.placement + "?x=" + encodeURIComponent(x.value) + "&y=" + encodeURIComponent(y.value) + "&size=" + encodeURIComponent(size.value),
                    { headers: { Accept: "application/json" }, credentials: "same-origin" })
                    .then(function (r) { return r.json(); })
                    .then(function (j) { text.textContent = j.text; })
                    .catch(function () { /* the sentence refreshes on submit instead */ });
            }, 250);
        }
        [x, y, size].forEach(function (el) { el.addEventListener("change", refresh); el.addEventListener("input", refresh); });
    })();
    </script>
}
}
