@page "/{slug:regex(^(terms|privacy|cookies|contact)$)}"
@model DreamGrid.Launcher.Pages.LegalModel
@{
    Layout = "_GuestLayout";
    ViewData["Title"] = Model.PageTitle;
}
<h1>@Model.PageTitle</h1>
@if (Model.ShownIn is not null)
{
    <div class="alert alert-info" role="note">@Model.ShownIn</div>
}
<p class="text-body-secondary">@T["Legal.VersionSaved", Model.Version, Model.Saved]</p>
<article>@Html.Raw(Model.Html)</article>
