@page "/security/wording"
@model DreamGrid.Launcher.Pages.Security.WordingModel
@{
    ViewData["Title"] = "Page wording";
}
<h1>Page wording</h1>
<p>The headings and opening words of the guest pages, in each language. Each one starts with GridGate's own wording, shown
    beside the box. Write your own to replace it, or leave the box empty to keep the original. Use <code>{grid}</code> where
    the grid's name should go. The text is plain: no formatting, and it can be up to @(WordingModel.MaxLength.ToString("N0")) characters.</p>
<p><a href="/guest-pages">Back to Guest pages</a></p>
@if (Model.Notice is not null)
{
    <div class="ok-box alert alert-success" role="status">@Model.Notice</div>
}

<form method="get" action="/security/wording" class="d-flex flex-wrap align-items-end gap-2">
    <div>
        <label class="form-label" for="wording-lang">Language</label>
        <select class="form-select" id="wording-lang" name="lang">
            @foreach (var code in Model.Languages)
            {
                <option value="@code" selected="@(code == Model.Lang)">@DreamGrid.Launcher.Core.Languages.NativeName(code)</option>
            }
        </select>
    </div>
    <button type="submit" class="btn btn-outline-secondary">Show</button>
</form>

@foreach (var row in Model.Rows)
{
    <section id="wording-@row.Key" data-key="@row.Key" class="card card-body mt-3">
        <h2 class="h5">@row.Title@(row.Changed ? " (changed)" : "")</h2>
        @if (row.Error is not null)
        {
            <div class="error alert alert-danger" role="alert">@row.Error</div>
        }
        <p class="form-text mb-1">The original wording:</p>
        <p class="built-in border rounded p-2 text-wrap">@row.BuiltIn</p>
        <form method="post" action="/security/wording?handler=Save" asp-antiforgery="true">
            <input type="hidden" name="lang" value="@Model.Lang">
            <input type="hidden" name="key" value="@row.Key">
            <label class="form-label" for="text-@row.Key">Your wording</label>
            <textarea class="form-control" id="text-@row.Key" name="Text" rows="4">@row.Mine</textarea>
            <div class="d-flex flex-wrap gap-2 mt-3">
                <button type="submit" class="btn btn-primary">Save</button>
                @if (row.Changed)
                {
                    <button type="submit" class="btn btn-outline-danger" formaction="/security/wording?handler=Reset">Put the original back</button>
                }
            </div>
        </form>
    </section>
}

@if (Model.Unused.Count > 0)
{
    <section id="no-longer-used" class="card card-body mt-4">
        <h2 class="h5">No longer used</h2>
        <p class="form-text">Wording you saved for texts the guest pages no longer let you change. It has no effect.</p>
        @foreach (var item in Model.Unused)
        {
            <form method="post" action="/security/wording?handler=Delete" asp-antiforgery="true" class="border-top pt-2 mt-2">
                <input type="hidden" name="lang" value="@Model.Lang">
                <input type="hidden" name="key" value="@item.Key">
                <p class="mb-1"><code>@item.Key</code></p>
                <p class="border rounded p-2 text-wrap">@item.Value</p>
                <button type="submit" class="btn btn-outline-danger btn-sm">Delete</button>
            </form>
        }
    </section>
}
