@page "/security/starter-avatars"
@model DreamGrid.Launcher.Pages.Security.StarterAvatarsModel
@{
    ViewData["Title"] = "Starter avatars";
}
<p class="back-link"><a href="/guest-pages">‹ Guest pages</a></p>
<h1>Starter avatars</h1>
<p>New residents choose one of these on the second step of signing up, and log in wearing it with copies of everything it wears in their inventory. An avatar is on the sign-up page once it has a snapshot and its model passed <strong>Check it</strong>.</p>
@if (Model.Error is not null)
{
    <div class="error-box error alert alert-danger" role="alert">@Model.Error</div>
}
@if (Model.Notice is not null)
{
    <div class="ok-box alert alert-success" role="status">@Model.Notice</div>
}

@if (Model.Avatars.Count == 0)
{
    <p class="text-body-secondary">There are no starter avatars yet, so new residents get the plain avatar.</p>
}
@for (var i = 0; i < Model.Avatars.Count; i++)
{
    var a = Model.Avatars[i];
    <section class="card card-body mb-3 starter-row" id="avatar-@a.Id.ToString("N")">
        <div class="d-flex flex-wrap gap-3">
            <div style="width:120px">
                @if (a.Snapshot is not null)
                {
                    <img class="img-fluid rounded border" src="/security/starter-avatars?handler=Picture&id=@a.Id" alt="@a.Name">
                }
                else
                {
                    <div class="border rounded text-center text-body-secondary p-3 small">No snapshot</div>
                }
            </div>
            <div class="flex-grow-1">
                <h2 class="h5 mb-1">@a.Name @if (a.Id == Model.EffectiveDefault) { <span class="badge text-bg-primary">Default</span> }</h2>
                <p class="small text-body-secondary mb-2">Model account: @a.ModelName · @StarterAvatarsModel.Status(a)</p>
                <ul class="list-unstyled small mb-2">
                    <li>@(a.Snapshot is not null ? "✓" : "✗") Snapshot</li>
                    <li>@(a.CheckPassed ? "✓" : "✗") Worn and checked@(a.CheckedAt is { } at ? $" ({at.UtcDateTime:yyyy-MM-dd HH:mm} UTC)" : "")</li>
                    <li>@(a.IsReady ? "✓" : "✗") Ready</li>
                </ul>
                @if (a.Warning is not null)
                {
                    <div class="alert alert-warning py-2 small" role="alert">@a.Warning</div>
                }
                <form method="post" asp-page-handler="Snapshot" enctype="multipart/form-data" class="d-flex flex-wrap gap-2 align-items-center mb-2">
                    <input type="hidden" name="id" value="@a.Id">
                    <label class="visually-hidden" for="file-@a.Id">Snapshot for @a.Name</label>
                    <input class="form-control form-control-sm w-auto" type="file" id="file-@a.Id" name="file" accept="image/png,image/jpeg,image/webp" required>
                    <button class="btn btn-sm btn-outline-primary" type="submit">Upload snapshot</button>
                </form>
                <form method="post" asp-page-handler="Rename" class="d-flex flex-wrap gap-2 align-items-center mb-2">
                    <input type="hidden" name="id" value="@a.Id">
                    <label class="visually-hidden" for="name-@a.Id">Name of @a.Name</label>
                    <input class="form-control form-control-sm w-auto" id="name-@a.Id" name="name" value="@a.Name" maxlength="@StarterAvatarsModel.MaxName" required>
                    <button class="btn btn-sm btn-outline-secondary" type="submit">Rename</button>
                </form>
                <div class="d-flex flex-wrap gap-2">
                    <form method="post" asp-page-handler="Move"><input type="hidden" name="id" value="@a.Id"><input type="hidden" name="delta" value="-1"><button class="btn btn-sm btn-outline-secondary" type="submit" disabled="@(i == 0)">Move up</button></form>
                    <form method="post" asp-page-handler="Move"><input type="hidden" name="id" value="@a.Id"><input type="hidden" name="delta" value="1"><button class="btn btn-sm btn-outline-secondary" type="submit" disabled="@(i == Model.Avatars.Count - 1)">Move down</button></form>
                    <form method="post" asp-page-handler="Default"><input type="hidden" name="id" value="@a.Id"><button class="btn btn-sm btn-outline-secondary" type="submit" disabled="@(a.Id == Model.DefaultId)">Make default</button></form>
                    @if (a.Hidden)
                    {
                        <form method="post" asp-page-handler="Show"><input type="hidden" name="id" value="@a.Id"><button class="btn btn-sm btn-outline-secondary" type="submit">Show at sign-up</button></form>
                    }
                    else
                    {
                        <form method="post" asp-page-handler="Hide"><input type="hidden" name="id" value="@a.Id"><button class="btn btn-sm btn-outline-secondary" type="submit">Hide from sign-up</button></form>
                    }
                    <form method="post" asp-page-handler="Remove" data-confirm="Take @a.Name off the list? Residents who picked it keep their copies.">
                        <input type="hidden" name="id" value="@a.Id">
                        <div class="form-check form-check-inline small">
                            <input class="form-check-input" type="checkbox" name="deleteModel" value="true" id="del-@a.Id">
                            <label class="form-check-label" for="del-@a.Id">also delete its model account</label>
                        </div>
                        <button class="btn btn-sm btn-outline-danger" type="submit">Remove</button>
                    </form>
                </div>
            </div>
        </div>
    </section>
}
<script src="/js/confirm.js"></script>
