@page "/security/legal"
@model DreamGrid.Launcher.Pages.Security.LegalModel
@using DreamGrid.Launcher.Core.Guests
@using DreamGrid.Launcher.Guests
@{
    ViewData["Title"] = "Legal pages";
}
<p class="back-link"><a href="/guest-pages">‹ Guest pages</a></p>
<h1>Legal pages</h1>
<partial name="_PlainHttpWarning" />
@if (Model.Notice is not null)
{
    <div class="ok-box alert alert-success" role="status">@Model.Notice</div>
}
<p>Guests see these pages on your website. You write them: DreamGrid supplies no wording. Use Markdown. Leave a page empty to remove it.</p>
<p id="gate-state" class="fw-semibold">@Model.GateText</p>

<form id="sign-up-switch" method="post" action="/security/legal?handler=SignUp" asp-antiforgery="true" class="mb-3">
    <div class="form-check form-switch">
        <input class="form-check-input" type="checkbox" role="switch" id="SignUpOpen" name="SignUpOpen" value="true"
               checked="@Model.SignUpOpen" disabled="@(!Model.GateOpen)">
        <label class="form-check-label" for="SignUpOpen">Let people sign up</label>
    </div>
    <p class="hint form-text">New residents make their own avatar on the sign-up page.@(Model.EmailReady ? " They confirm it with a link sent by email." : "")</p>
    <button type="submit" class="btn btn-outline-primary btn-sm" disabled="@(!Model.GateOpen && !Model.SignUpOpen)">Save this</button>
</form>
@if (Model.SignUpOpen && Model.BotsAllOff)
{
    <div id="sign-up-warn-bots" class="alert alert-warning" role="alert">Every protection is off. Bots can create accounts freely.</div>
}
@if (Model.SignUpOpen && !Model.EmailReady)
{
    <div id="sign-up-warn-email" class="alert alert-warning" role="alert">Email isn't set up, so anyone can sign up without proving an email address.</div>
}

<div class="row g-4">
<div class="col-lg-8">
<nav id="legal-languages" aria-label="Language" class="mb-3">
    <ul class="nav nav-pills flex-wrap">
        @foreach (var choice in Model.Choices)
        {
            var current = string.Equals(choice.Code, Model.Language, StringComparison.OrdinalIgnoreCase);
            var source = string.Equals(choice.Code, Model.Source, StringComparison.OrdinalIgnoreCase);
            <li class="nav-item">
                <a class="nav-link @(current ? "active" : "")" href="/security/legal?lang=@choice.Code" aria-current="@(current ? "page" : null)">@(choice.Name)@(source ? " (the source)" : "")@if (choice.OutOfDate)
                    {
                        <span class="badge text-bg-warning ms-1">out of date</span>
                    }</a>
            </li>
        }
    </ul>
</nav>
@if (Model.IsSource)
{
    <p id="legal-language-note" class="form-text">@DreamGrid.Launcher.Core.Languages.NativeName(Model.Language) is the grid's default language, so these
        texts are the source. Saving a change gives it a new version, and translations show the source until they are updated.</p>
}
else
{
    <p id="legal-language-note" class="form-text">The @DreamGrid.Launcher.Core.Languages.NativeName(Model.Language) translation. A page is shown to readers
        of @DreamGrid.Launcher.Core.Languages.NativeName(Model.Language) only while it matches the latest version in
        @DreamGrid.Launcher.Core.Languages.NativeName(Model.Source); until then they see the @DreamGrid.Launcher.Core.Languages.NativeName(Model.Source) text.</p>
}
@if (Model.Error is not null)
{
    <div class="error-box error alert alert-danger" role="alert">@Model.Error</div>
}
<form id="legal-texts" method="post" action="/security/legal?lang=@Model.Language" asp-antiforgery="true">
    <input type="hidden" name="lang" value="@Model.Language">
    @foreach (var id in LegalPages.All)
    {
        <div class="mb-3">
            <label class="form-label" for="text-@id">@LegalPages.Title(id)@(id == LegalPages.Contact ? " (optional)" : "")@if (Model.OutOfDate.Contains(id))
                {
                    <span class="out-of-date badge text-bg-warning ms-1">out of date</span>
                }</label>
            <textarea class="form-control" id="text-@id" name="Texts[@id]" rows="10" autocomplete="off" spellcheck="true">
@(Model.Texts.GetValueOrDefault(id))</textarea>
            @if (Model.OutOfDate.Contains(id))
            {
                <div class="form-check mt-1">
                    <input class="form-check-input" type="checkbox" id="matches-@id" name="Matches[@id]" value="true">
                    <label class="form-check-label" for="matches-@id">This translation still matches the current version</label>
                </div>
            }
        </div>
    }
    @if (Model.IsSource)
    {
        <div class="form-check mb-3">
            <input class="form-check-input" type="checkbox" id="SmallFix" name="SmallFix" value="true">
            <label class="form-check-label" for="SmallFix">Small fix only (a typo or a broken link): keep the version numbers, so nobody has to accept the Terms again</label>
        </div>
    }
    <button type="submit" formaction="/security/legal?handler=Save&amp;lang=@Model.Language" class="btn btn-primary">Save</button>
    <button type="submit" formaction="/security/legal?handler=Preview&amp;lang=@Model.Language" class="btn btn-outline-secondary">Preview</button>
</form>

<form id="legal-responsibility" class="mt-4" method="post" action="/security/legal?handler=Responsibility" asp-antiforgery="true">
    <div class="form-check">
        <input class="form-check-input" type="checkbox" id="Responsible" name="Responsible" value="true" checked="@Model.Responsible">
        <label class="form-check-label" for="Responsible">I wrote these notices and I am responsible for them.</label>
    </div>
    <button type="submit" class="btn btn-outline-primary btn-sm mt-2">Save this</button>
</form>

@if (Model.Previews.Count > 0)
{
    <section id="previews" class="mt-4">
        <h2>Preview</h2>
        <p class="hint form-text">Nothing is saved yet.</p>
        @foreach (var (title, html) in Model.Previews)
        {
            <article class="card card-body mb-3">
                <h3>@title</h3>
                @Html.Raw(html)
            </article>
        }
    </section>
}
</div>

<div class="col-lg-4">
<aside id="site-facts" class="card card-body">
    <h2 class="h5">Facts about this software, not legal text</h2>
    <h3 class="h6 mt-2">Cookies this website sets</h3>
    <ul class="small">
        @foreach (var (name, purpose) in SiteFacts.Cookies)
        {
            <li><code>@name</code>: @purpose</li>
        }
    </ul>
    <h3 class="h6 mt-2">What is stored, and where</h3>
    <ul class="small mb-0">
        @foreach (var (what, where) in SiteFacts.Stored)
        {
            <li>@what: @where</li>
        }
    </ul>
</aside>
</div>
</div>
