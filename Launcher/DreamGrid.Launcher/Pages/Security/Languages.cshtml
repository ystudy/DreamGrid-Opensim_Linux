@page "/security/languages"
@model DreamGrid.Launcher.Pages.Security.LanguagesModel
@{
    ViewData["Title"] = "Languages";
}
<h1>Languages</h1>
<p>The languages the guest pages and the emails to residents come in. GridGate has some built in, and you can add your own and
    translate it here. A text you haven't translated yet is shown in English.</p>
<p><a href="/guest-pages">Back to Guest pages</a></p>
@if (Model.Notice is not null)
{
    <div class="ok-box alert alert-success" role="status">@Model.Notice</div>
}
@if (Model.Error is not null)
{
    <div class="error-box error alert alert-danger" role="alert">@Model.Error</div>
}
@if (Model.ConfirmDelete is { } doomed)
{
    <form id="confirm-delete" method="post" action="/security/languages?handler=Delete" asp-antiforgery="true" class="card card-body border-danger mb-3">
        <input type="hidden" name="code" value="@doomed.Code">
        <input type="hidden" name="confirm" value="true">
        <p class="mb-2">Delete @doomed.Name (@doomed.Code) and all its translations? This can't be undone, so download its file first if you may want it again.</p>
        <p class="mb-2">@(doomed.Residents == 1 ? "1 resident chose" : $"{doomed.Residents} residents chose") this language. They get the default language instead.</p>
        <div class="d-flex flex-wrap gap-2">
            <button type="submit" class="btn btn-danger">Delete @doomed.Name</button>
            <a class="btn btn-outline-secondary" href="/security/languages">Keep it</a>
        </div>
    </form>
}

<div class="table-responsive">
    <table id="languages" class="table align-middle">
        <thead>
            <tr><th>Language</th><th>Kind</th><th>Offered</th><th>Default</th><th>Translated</th><th>Residents using it</th><th></th></tr>
        </thead>
        <tbody>
            @foreach (var row in Model.Rows)
            {
                <tr data-code="@row.Code">
                    <td><span class="fw-semibold">@row.Name</span> <code>@row.Code</code></td>
                    <td class="kind">@(row.BuiltIn ? "Built in" : "Added")</td>
                    <td class="offered">@(row.Offered ? "Yes" : "No")</td>
                    <td class="default">@(row.Default ? "Yes" : "No")</td>
                    <td class="missing">
                        @if (row.BuiltIn)
                        {
                            <span class="form-text">Complete</span>
                        }
                        else
                        {
                            <a href="/security/languages/@row.Code">Missing: @row.Missing</a>
                        }
                    </td>
                    <td class="residents">@row.Residents</td>
                    <td>
                        @if (!row.BuiltIn)
                        {
                            <form method="post" action="/security/languages?handler=Delete" asp-antiforgery="true">
                                <input type="hidden" name="code" value="@row.Code">
                                <button type="submit" class="btn btn-outline-danger btn-sm">Delete</button>
                            </form>
                        }
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>

<section id="add-language" class="card card-body mt-4">
    <h2 class="h5">Add a language</h2>
    <p class="form-text">Pick one the system knows. It starts empty, and residents don't see it until you offer it.</p>
    <form method="post" action="/security/languages?handler=Add" asp-antiforgery="true" class="d-flex flex-wrap align-items-end gap-2">
        <div>
            <label class="form-label" for="add-code">Language</label>
            <select class="form-select" id="add-code" name="code">
                @foreach (var choice in Model.Choices)
                {
                    <option value="@choice.Code">@choice.Label</option>
                }
            </select>
        </div>
        <button type="submit" class="btn btn-primary">Add</button>
    </form>
</section>
