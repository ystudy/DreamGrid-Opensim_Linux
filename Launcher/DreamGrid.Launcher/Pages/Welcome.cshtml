@page "/welcome"
@model DreamGrid.Launcher.Pages.WelcomeModel
@{
    Layout = "_SplashLayout";
    ViewData["Title"] = Model.Settings.GridName;
    ViewData["SplashVersion"] = Model.View.Version;
}
<div class="splash-page">
    @foreach (var block in Model.View.Design.Blocks)
    {
        <partial name="_SplashBlock" model="new DreamGrid.Launcher.Splash.SplashBlockView(block, Model.View.Status, Model.Settings)" />
    }
</div>
