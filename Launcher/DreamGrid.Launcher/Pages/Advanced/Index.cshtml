@page "/advanced"
@model DreamGrid.Launcher.Pages.Advanced.IndexModel
@{
    ViewData["Title"] = "Advanced Settings";
}
<h1>Advanced Settings</h1>
<p class="muted">Most worlds never need these. A change here applies when your world restarts.</p>
<ul class="menu">
    <li><a href="/advanced/network">Network</a><span class="hint">The address people connect to, and the ports.</span></li>
    <li><a href="/advanced/database">Database</a><span class="hint">The database connection and its passwords.</span></li>
    @foreach (var module in Model.ModulePages)
    {
        <li><a href="/advanced/module/@Uri.EscapeDataString(module.ModuleId)">@module.Title</a></li>
    }
    <li><a href="/logs">Logs</a><span class="hint">What the launcher, Robust and your region wrote.</span></li>
</ul>
