@page "/advanced/plan"
@model DreamGrid.Launcher.Pages.Advanced.PlanModel
@{
    ViewData["Title"] = "Plan";
    ViewData["Wide"] = true;
}
<nav aria-label="breadcrumb"><ol class="breadcrumb"><li class="breadcrumb-item"><a href="/advanced">Settings</a></li><li class="breadcrumb-item active" aria-current="page">@ViewData["Title"]</li></ol></nav>
<h1>Your plan: @Model.Current.Icon @Model.Current.Title</h1>
@if (Model.SavedNotes is { } notes)
{
    <partial name="_Saved" model="notes" />
}
@if (Model.Problem is { } problem)
{
    <div class="error-box alert alert-danger" role="alert">@problem</div>
}
@* What this plan is on the left; what you can change on the right. *@
<div class="list-columns plan-columns">
    <section class="work-panel">
        <partial name="_PlanDetails" model="Model.Current" view-data='new Microsoft.AspNetCore.Mvc.ViewFeatures.ViewDataDictionary(ViewData) { ["Advisories"] = Model.Advisories }' />
    </section>

    <div class="side-stack">
        @if (Model.Switch is { } sw)
        {
            <section class="work-panel">
                <h2 class="panel-title">Hypergrid</h2>
                <form id="hypergrid" method="post" asp-page-handler="Hypergrid">
                    <partial name="_HypergridSwitch" model="sw" />
                    @if (sw.Allowed)
                    {
                        <button type="submit" class="btn btn-primary mt-3 w-100">Save</button>
                    }
                </form>
            </section>
        }

        @if (Model.HypergridLine is { } hypergridLine)
        {
            <section class="work-panel">
                <h2 class="panel-title">Hypergrid</h2>
                <p id="region-hypergrid" class="hint form-text mb-0">@hypergridLine</p>
            </section>
        }
        @if (Model.GridAssetAddress is { } gridAssetAddress)
        {
            <section class="work-panel">
                <h2 class="panel-title">Grid Asset Server</h2>
                <p>This computer adds regions to the grid at <strong>@gridAssetAddress</strong>.</p>
                <a class="btn btn-outline-primary w-100" href="/advanced/join" icon="link">Point at a different Grid Asset Server</a>
            </section>
        }

        @if (Model.ConnectedGrid is { } connectedGrid)
        {
            <section class="work-panel">
                <h2 class="panel-title">Your grid</h2>
                <p class="mb-0">This computer runs regions on <strong>@connectedGrid.GridName</strong>. Its login address is <strong>@connectedGrid.LoginUri</strong>.</p>
            </section>
        }

        <section class="work-panel">
            <h2 class="panel-title">Change plan<help-tip class="help-end">Some plans can't be reached from this one; the reason is shown under the ones you can't pick.</help-tip></h2>
            <ul class="plan-allowed list-unstyled mb-0">
                @foreach (var c in Model.Changes.Where(c => c.Allowed))
                {
                    <li class="mb-3">
                        <form method="post" asp-page-handler="Change">
                            <button type="submit" name="To" value="@c.Plan.Id" class="btn btn-outline-primary w-100" icon="arrow-right">Change to @c.Plan.Title</button>
                        </form>
                        <span class="hint form-text d-block">@c.Plan.Summary</span>
                    </li>
                }
            </ul>
            <ul class="plan-refused list-unstyled mb-0">
                @foreach (var c in Model.Changes.Where(c => !c.Allowed))
                {
                    <li class="mb-2">✘ <strong>@c.Plan.Title</strong>: <span class="hint form-text d-inline">@c.Reason</span></li>
                }
            </ul>
        </section>
    </div>
</div>
