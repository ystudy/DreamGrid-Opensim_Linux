@page "/advanced/network"
@model DreamGrid.Launcher.Pages.Advanced.NetworkModel
@using DreamGrid.Launcher.Core.Settings
@{
    ViewData["Title"] = "Network";
}
<nav aria-label="breadcrumb"><ol class="breadcrumb"><li class="breadcrumb-item"><a href="/advanced">Advanced Settings</a></li><li class="breadcrumb-item active" aria-current="page">@ViewData["Title"]</li></ol></nav>
<h1>Network</h1>
@if (Model.SavedNotes is { } notes)
{
    <partial name="_Saved" model="notes" />
}
<form id="network" method="post">
    <label class="form-label mt-3" for="Hostname">Hostname or IP address</label>
    <input class="form-control" id="Hostname" name="Hostname" value="@Model.Hostname" placeholder="@Model.DetectedAddress" autocomplete="off" autocapitalize="off" spellcheck="false">
    <span class="hint form-text d-block">The address Firestorm uses to reach your world. Leave it empty to use the detected address, @Model.DetectedAddress.</span>
    <span class="field-error text-danger small d-block" data-error-for="Hostname">@Model.Errors.GetValueOrDefault("Hostname")</span>

    @foreach (var (key, label) in SettingsValidator.PortFields)
    {
        <label class="form-label mt-3" for="@key">@label</label>
        <input class="form-control" id="@key" name="@key" value="@Model.Ports.GetValueOrDefault(key)" inputmode="numeric" autocomplete="off" required>
        <span class="field-error text-danger small d-block" data-error-for="@key">@Model.Errors.GetValueOrDefault(key)</span>
    }
    <p class="hint form-text">Each port is a number from @SettingsValidator.MinPort to @SettingsValidator.MaxPort, and no two can be the same.</p>
    <button type="submit" class="btn btn-primary mt-3">Save</button>
</form>
