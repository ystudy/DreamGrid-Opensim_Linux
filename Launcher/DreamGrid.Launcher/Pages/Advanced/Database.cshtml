@page "/advanced/database"
@model DreamGrid.Launcher.Pages.Advanced.DatabaseModel
@using DreamGrid.Launcher.Pages.Advanced
@{
    ViewData["Title"] = "Database";
    var s = Model.Settings;
    string Password(string value) => Model.Revealed ? value : DatabaseModel.Masked;
}
<p><a href="/advanced">Advanced Settings</a></p>
<h1>Database</h1>
<p class="muted">Your world keeps its data in its own MariaDB, which only this computer can reach. Robust uses the robustuser account and your region the opensimuser account.</p>

<section class="card">
    <dl class="facts">
        <dt>Host</dt>
        <dd>@DatabaseModel.Host</dd>
        <dt>Port</dt>
        <dd>@s.MariaDbPort <span class="hint">Change it under <a href="/advanced/network">Network</a>.</span></dd>
        <dt>Robust user</dt>
        <dd><code>robustuser</code></dd>
        <dt>Robust password</dt>
        <dd><code>@Password(s.Db.RobustPassword)</code></dd>
        <dt>Region user</dt>
        <dd><code>opensimuser</code></dd>
        <dt>Region password</dt>
        <dd><code>@Password(s.Db.OpensimPassword)</code></dd>
    </dl>
    <div class="button-row">
        @if (!Model.Revealed)
        {
            <form method="post" asp-page-handler="Show" onsubmit="return confirm('Show the database passwords on this screen?');">
                <button type="submit" class="secondary">Show passwords</button>
            </form>
        }
        <form method="post" asp-page-handler="Test">
            <button type="submit" class="secondary">Test connection</button>
        </form>
    </div>
</section>

@if (Model.Test.Tested)
{
    if (Model.Test.Error is null)
    {
        <p id="test-result" class="ok-box" role="status">Connected as robustuser to @DatabaseModel.Host:@s.MariaDbPort.</p>
    }
    else
    {
        <div id="test-result" class="error-box" role="status">
            <p>Could not connect as robustuser to @DatabaseModel.Host:@s.MariaDbPort.</p>
            <pre>@Model.Test.Error</pre>
        </div>
    }
}
