@page "/advanced/password-reset"
@model DreamGrid.Launcher.Pages.Advanced.PasswordResetModel
@using DreamGrid.Launcher.Core.Security
@using DreamGrid.Launcher.Core.Settings
@{
    ViewData["Title"] = "Password reset";
    var groups = new[] { ("Residents", "Residents", Model.Rules.Residents), ("Staff", "Staff (supervisors and admins)", Model.Rules.Staff), ("Owner", "You, the owner", Model.Rules.Owner) };
}
<h1>Password reset</h1>
<p>How people get back in when they forget their password. The rule that applies is the one for the account, whichever page they ask on.</p>
@if (Model.Unset)
{
    <div id="recovery-unset" class="alert alert-info" role="status">Password reset is available. Choose a level to turn it on.</div>
}
@if (!Model.EmailReady)
{
    <div id="email-first" class="alert alert-warning" role="status">Password reset sends an email, and the grid can't send email yet. <a href="/security/email">Set up email</a> first.</div>
}
@if (Model.Error is not null)
{
    <div class="error-box error alert alert-danger" role="alert">@Model.Error</div>
}
@if (Model.Notice is not null)
{
    <div class="alert alert-success" role="status">@Model.Notice</div>
}

<h2 class="mt-4">Use a level</h2>
<form id="level" method="post" asp-page-handler="Level">
    @foreach (var kind in Enum.GetValues<GridKind>())
    {
        var id = "kind-" + kind;
        <div class="form-check mt-2">
            <input class="form-check-input" type="radio" name="Kind" id="@id" value="@kind" required>
            <label class="form-check-label fw-semibold" for="@id">@Recovery.Title(kind)</label>
            <div class="form-text">@Recovery.Line(kind)</div>
        </div>
    }
    <button type="submit" class="btn btn-outline-primary mt-3">Use this level</button>
</form>

<h2 class="mt-4">Or set each rule</h2>
<form id="rules" method="post" asp-page-handler="Save">
    @foreach (var (name, label, current) in groups)
    {
        <label class="form-label mt-3" for="rule-@name">@label</label>
        <select class="form-select" id="rule-@name" name="@name">
            @foreach (var rule in Enum.GetValues<RecoveryRule>())
            {
                <option value="@rule" selected="@(rule == current)">@DreamGrid.Launcher.Pages.Advanced.PasswordResetModel.Title(rule)</option>
            }
        </select>
    }
    <p class="form-text mt-2">With "Email link + two-factor", people who haven't set up two-factor get the email link alone.</p>
    <div class="form-check mt-3">
        <input class="form-check-input" type="checkbox" id="require-two-factor" name="RequireTwoFactor" value="true" checked="@Model.RequireTwoFactor">
        <label class="form-check-label" for="require-two-factor">Staff must use two-factor sign-in</label>
    </div>
    <button type="submit" class="btn btn-primary mt-3">Save</button>
</form>
