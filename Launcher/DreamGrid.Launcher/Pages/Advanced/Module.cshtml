@page "/advanced/module/{id}"
@model DreamGrid.Launcher.Pages.Advanced.ModuleModel
@{
    ViewData["Title"] = Model.Module.Title;
}
<nav aria-label="breadcrumb"><ol class="breadcrumb"><li class="breadcrumb-item"><a href="/advanced">Advanced Settings</a></li><li class="breadcrumb-item active" aria-current="page">@ViewData["Title"]</li></ol></nav>
<h1>@Model.Module.Title</h1>
@if (Model.Saved)
{
    <partial name="_Saved" model="Array.Empty<string>()" />
}
<form id="module" method="post">
    @foreach (var f in Model.Fields)
    {
        var id = "field-" + f.Key;
        <label class="form-label mt-3" for="@id">@f.Label</label>
        @switch (f.Kind)
        {
            case "select":
                <select class="form-select" id="@id" name="@f.Key">
                    @foreach (var option in f.Options ?? [])
                    {
                        <option value="@option" selected="@(option == f.Value)">@option</option>
                    }
                </select>
                break;
            case "secret":
                @* Never echoed: leaving it empty keeps the saved value. *@
                <input class="form-control" id="@id" name="@f.Key" type="password" value="" placeholder="Unchanged" autocomplete="new-password">
                break;
            case "number":
                <input class="form-control" id="@id" name="@f.Key" value="@f.Value" inputmode="numeric" autocomplete="off">
                break;
            default:
                <input class="form-control" id="@id" name="@f.Key" value="@f.Value" autocomplete="off">
                break;
        }
        @if (f.Help is not null)
        {
            <span class="hint form-text d-block">@f.Help</span>
        }
        <span class="field-error text-danger small d-block" data-error-for="@f.Key">@Model.Errors.GetValueOrDefault(f.Key)</span>
    }
    <button type="submit" class="btn btn-primary mt-3">Save</button>
</form>
