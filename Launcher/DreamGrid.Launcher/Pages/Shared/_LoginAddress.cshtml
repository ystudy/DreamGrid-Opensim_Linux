@model (string Label, string Uri)
@* The grid's login address under its label, in a highlighted panel, with a Copy button (shown by /js/connect.js once scripts run). *@
<div class="login-address mb-3">
    <p id="login-uri-label" class="login-address-label">@Model.Label</p>
    <div class="input-group copy-row">
        <code id="login-uri" class="form-control login-uri" aria-labelledby="login-uri-label">@Model.Uri</code>
        <button type="button" id="copy-uri" class="btn btn-primary" hidden>Copy</button>
    </div>
</div>
