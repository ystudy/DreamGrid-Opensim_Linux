@using System.Reflection
@using DreamGrid.Launcher.Core.Settings
@inject Func<LauncherSettings> Settings
@{
    var version = typeof(Program).Assembly.GetCustomAttribute<AssemblyInformationalVersionAttribute>()?.InformationalVersion ?? "dev";
    var gridName = Settings().GridName;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>@(ViewData["Title"] is string t ? t + " - " : "")@gridName</title>
    <link rel="stylesheet" href="/css/site.css">
</head>
<body>
<header>
    <strong class="grid-name">@gridName</strong>
    @if (User.Identity?.IsAuthenticated == true)
    {
        <nav>
            <a href="/">Home</a>
            <a href="/advanced">Advanced</a>
            <a href="/logs">Logs</a>
            <a href="/logout">Sign out</a>
        </nav>
    }
</header>
<main>
    @RenderBody()
</main>
<footer>DreamGrid @version</footer>
<script src="/js/live.js"></script>
@await RenderSectionAsync("Scripts", required: false)
</body>
</html>
