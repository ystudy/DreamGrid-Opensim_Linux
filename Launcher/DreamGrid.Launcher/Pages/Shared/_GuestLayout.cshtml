@using System.Globalization
@using DreamGrid.Launcher.Core.Settings
@inject Func<LauncherSettings> Settings
@{
    var gridName = Settings().GridName;
    // Asked of the staff cookie itself: on the guest pages User is the guest sign-in (the Guest policy's scheme).
    var staffUser = (await Microsoft.AspNetCore.Authentication.AuthenticationHttpContextExtensions.AuthenticateAsync(Context, DreamGrid.Launcher.Security.AuthSchemes.Admin)).Principal;
    var isStaff = staffUser is not null && DreamGrid.Launcher.Security.StaffSignIn.RoleOf(staffUser) != DreamGrid.Launcher.Core.Security.StaffRole.None;
    // From the culture the page is rendered in (ResidentLanguageFilter sets it), so what is written here is what the page really uses.
    var culture = CultureInfo.CurrentUICulture;
    var rtl = culture.TextInfo.IsRightToLeft;
    var lang = culture.TwoLetterISOLanguageName is { Length: 2 } two ? two : "en";
}
<!DOCTYPE html>
<html lang="@lang" dir="@(rtl ? "rtl" : "ltr")">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>@(ViewData["Title"] is string t ? t + " - " : "")@gridName</title>
    <script src="/js/theme.js"></script>
    <link rel="stylesheet" href="@(rtl ? "/lib/bootstrap/bootstrap.rtl.min.css" : "/lib/bootstrap/bootstrap.min.css")">
    <link rel="stylesheet" href="/css/site.css">
    @await RenderSectionAsync("Head", required: false)
</head>
<body class="@(ViewData["Wide"] switch { true => "page-wide", "full" => "page-full", _ => null })">
@* The guest pages: the grid's name and nothing of the staff side. *@
<header class="navbar navbar-expand bg-body border-bottom shadow-sm">
    <div class="container">
        <strong class="navbar-brand grid-name me-auto">@gridName</strong>
        @* Help on every guest page, plus whatever a page adds (the front page: staff sign in). Not a <nav>: the guest side has no site navigation. *@
        <div class="guest-actions">
            @if (isStaff)
            {
                @* A staff member looking at the guest side (the staff menu's Guest view): the way back. *@
                <a id="staff-side-link" class="btn btn-sm btn-primary" href="/" icon="arrow-left">@T["Layout.BackToStaff"]</a>
                IgnoreSection("HeaderActions");
            }
            else
            {
                @await RenderSectionAsync("HeaderActions", required: false)
            }
            <a id="help-link" class="btn btn-sm btn-outline-secondary" href="/support" icon="help">@T["Layout.Help"]</a>
            <partial name="_LanguagePicker" />
        </div>
    </div>
</header>
<main class="container py-4">
    @RenderBody()
</main>
@* The legal pages the operator has written, then anything a page puts in a "Footer" section. *@
<footer class="container pb-4">
    <partial name="_LegalLinks" />
    @await RenderSectionAsync("Footer", required: false)
</footer>
<script src="/js/copy.js"></script>
<script src="/js/language.js"></script>
@await RenderSectionAsync("Scripts", required: false)
</body>
</html>
