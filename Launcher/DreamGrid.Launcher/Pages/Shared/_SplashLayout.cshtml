@{
    var version = ViewData["SplashVersion"] is int v ? v : 0;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>@ViewData["Title"]</title>
    <link rel="stylesheet" href="/css/splash.css">
    <link rel="stylesheet" href="/welcome/page-@(version).css">
</head>
@* The viewer's login screen: the owner's design and nothing else, no menu and no script. *@
<body class="splash">
@RenderBody()
</body>
</html>
