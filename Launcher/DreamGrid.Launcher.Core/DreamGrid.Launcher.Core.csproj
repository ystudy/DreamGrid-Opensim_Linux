  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Security\common-passwords.txt" LogicalName="DreamGrid.Launcher.Core.Security.common-passwords.txt" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="DreamGrid.Launcher.Tests" />
  </ItemGroup>

</Project>
