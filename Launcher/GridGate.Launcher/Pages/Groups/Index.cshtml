@page "/groups"
@model GridGate.Launcher.Pages.Groups.IndexModel
@{
    ViewData["Title"] = "Groups";
    ViewData["Wide"] = true;
}
<div class="page-head">
    <h1>Groups<help-tip class="help-start">The groups on your grid. Open one to change its name or charter, add or remove members, delete it, or make it the default group every new resident joins. Groups are made in the viewer.</help-tip></h1>
</div>
@if (Model.Notice is not null)
{
    <div class="ok-box alert alert-success" role="status">@Model.Notice</div>
}
<section class="work-panel" aria-labelledby="groups-title">
    <div class="panel-tools">
        <h2 id="groups-title" class="panel-title mb-0">Groups</h2>
        @if (!Model.Unavailable && Model.Any)
        {
            <form method="get" action="/groups" class="list-search ms-auto" role="search">
                <div class="input-group input-group-sm">
                    <label class="visually-hidden" for="q">Find a group</label>
                    <input class="form-control" type="search" id="q" name="q" value="@Model.Query" placeholder="Part of a name" autocomplete="off">
                    <button type="submit" class="btn btn-outline-primary" icon="search">Find</button>
                </div>
            </form>
        }
    </div>
    @if (Model.Unavailable)
    {
        <p id="groups-unavailable" class="mb-0">@GridGate.Launcher.Groups.GroupsAdmin.DatabaseDown</p>
    }
    else if (!Model.Any)
    {
        <p id="groups-none" class="mb-0">No groups yet. Groups are made in the viewer.</p>
    }
    else if (Model.Rows.Count == 0)
    {
        <p class="mb-0">No group's name has "@Model.Query" in it.</p>
    }
    else
    {
        <div class="table-responsive">
            <table id="groups-list" class="table align-middle mb-0">
                <thead><tr><th>Name</th><th>Founder</th><th class="text-end">Members</th><th>Open to join</th></tr></thead>
                <tbody>
                @foreach (var g in Model.Rows)
                {
                    <tr>
                        <td>
                            <a class="fw-semibold" href="/groups/group?id=@g.Id">@g.Name</a>
                            @if (g.Id == Model.DefaultGroup)
                            {
                                <span class="default-badge badge text-bg-info ms-1">Default</span>
                            }
                        </td>
                        <td>@g.Founder</td>
                        <td class="members text-end">@g.Members</td>
                        <td class="open">@(g.OpenToJoin ? "Yes" : "No")</td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    }
</section>
