@page "/profile/emails"
@model GridGate.Launcher.Pages.Profile.EmailsModel
@{
    ViewData["Title"] = "Email notices";
}
<h1>Email notices</h1>
@if (Model.Notice is not null)
{
    <div class="ok-box alert alert-success" role="status">@Model.Notice</div>
}
@if (Model.CanApprove || Model.HasTickets)
{
    <form id="emails" method="post" asp-antiforgery="true">
        @if (Model.CanApprove)
        {
            <div class="form-check form-switch mt-3">
                <input class="form-check-input" type="checkbox" role="switch" id="SignUpsWaiting" name="SignUpsWaiting" value="true" checked="@Model.SignUpsWaiting">
                <label class="form-check-label" for="SignUpsWaiting">Email me when new sign-ups are waiting for approval</label>
            </div>
        }
        @if (Model.HasTickets)
        {
            <div class="form-check form-switch mt-3">
                <input class="form-check-input" type="checkbox" role="switch" id="NewTickets" name="NewTickets" value="true" checked="@Model.NewTickets">
                <label class="form-check-label" for="NewTickets">New support tickets: email me when a ticket comes in or a guest replies</label>
            </div>
            <p class="hint form-text mb-0">A reply on a ticket you took comes only to you. The email names the tickets, never what anyone wrote.</p>
        }
        <p class="hint form-text">At most one email an hour for each, to the address on your avatar.</p>
        <button type="submit" class="btn btn-primary mt-3">Save</button>
    </form>
}
@if (!Model.CanApprove)
{
    <p class="mt-3">You can't approve sign-ups on this grid.</p>
}
