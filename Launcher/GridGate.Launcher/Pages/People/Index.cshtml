@page "/people"
@model GridGate.Launcher.Pages.People.IndexModel
@inject GridGate.Launcher.Core.Starter.StarterAvatarList Starters
@using GridGate.Launcher.Core.Database
@using GridGate.Launcher.Pages.People
@{
    ViewData["Title"] = "People";
    ViewData["Wide"] = true;
}
<div class="page-head">
    <h1>People<help-tip class="help-start">Find someone on your grid by part of their name, or pick who to show. Click a name to open the person, where you can change their role, email or password.</help-tip></h1>
</div>
<partial name="_HubLinks" model="@(new GridGate.Launcher.Navigation.HubLinks("People"))" />
<error-box text="@Model.Error" />
<ok-box text="@Model.Notice" />
<section class="work-panel mb-3" aria-labelledby="people-title">
    <div class="panel-tools">
        <h2 id="people-title" class="panel-title mb-0">Find a person</h2>
        <form id="people-search" method="get" action="/people" class="list-search ms-auto" role="search">
            <div class="input-group input-group-sm">
                <label class="visually-hidden" for="q">Name</label>
                <input class="form-control" id="q" name="q" value="@Model.Q" maxlength="64" autocomplete="off" autocapitalize="off" spellcheck="false" placeholder="Part of a name">
                <select class="form-select people-filter" name="filter" aria-label="Show">
                    @foreach (var (value, label) in new[] { (PeopleFilter.Everyone, "Everyone"), (PeopleFilter.Staff, "Staff"), (PeopleFilter.Suspended, "Suspended"), (PeopleFilter.Waiting, "Waiting for approval") })
                    {
                        <option value="@value" selected="@(Model.Filter == value)">@label</option>
                    }
                </select>
                <button type="submit" class="btn btn-primary" icon="search">Search</button>
            </div>
        </form>
    </div>
    @if (Model.Rows is { } rows)
    {
        <div class="table-responsive">
            <table id="people-list" class="table align-middle mb-2">
                <thead><tr><th>Name</th><th>Role</th><th>Email</th><th>Last seen</th><th>Tasks</th></tr></thead>
                <tbody>
                    @foreach (var row in rows)
                    {
                        var account = row.Row.Account;
                        <tr data-id="@account.PrincipalId">
                            <td>
                                <a class="person-name fw-semibold" href="/people/@account.PrincipalId">@row.FullName</a>
                                @if (row.Role.IsOwner) { <span class="badge text-bg-primary ms-1">Owner</span> }
                                @if (Starters.IsModel(account.PrincipalId)) { <span class="badge text-bg-info ms-1">Starter avatar</span> }
                                @if (row.Facts.Waiting) { <span class="badge text-bg-secondary ms-1">Waiting for approval</span> }
                                else if (row.Facts.Suspended) { <span class="badge text-bg-danger ms-1">Suspended</span> }
                            </td>
                            <td>@IndexModel.RoleWord(row)</td>
                            <td>@(string.IsNullOrWhiteSpace(account.Email) ? "None" : account.Email)</td>
                            <td>@Model.LastSeen(row.Row)</td>
                            <td><partial name="_TaskIcons" model="Model.IconsFor(row)" /></td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        <div class="list-pager">
            <span id="people-count" class="text-body-secondary">@Model.CountText</span>
            @if (Model.PageNumber > 1) { <a class="btn btn-sm btn-outline-secondary" href="@Model.PageLink(Model.PageNumber - 1)" icon="arrow-left">Previous</a> }
            @if (Model.HasNext) { <a class="btn btn-sm btn-outline-secondary" href="@Model.PageLink(Model.PageNumber + 1)" icon="arrow-right">Next</a> }
        </div>
    }
</section>
@if (Model.Found is { } p)
{
    <section id="person" class="work-panel">
        <h2 class="h4">
            @p.FullName
            @if (p.Suspended)
            {
                <span class="badge text-bg-danger ms-2">Suspended</span>
            }
            @if (p.Pending)
            {
                <span class="badge text-bg-secondary ms-2">@(p.WaitingForStaff ? "Waiting for approval" : "Waiting for email")</span>
            }
        </h2>
        @if (p.Pending)
        {
            <p><a href="/people/sign-ups">Approve or deny on the Sign-ups page</a></p>
        }
        <dl class="row mb-0">
            <dt class="col-sm-3">Role</dt>
            <dd class="col-sm-9">@p.RoleName</dd>
            <dt class="col-sm-3">Level</dt>
            <dd class="col-sm-9">@p.Account.UserLevel</dd>
            <dt class="col-sm-3">Email</dt>
            <dd class="col-sm-9">@(string.IsNullOrWhiteSpace(p.Account.Email) ? "None" : p.Account.Email)</dd>
            <dt class="col-sm-3">Created</dt>
            <dd class="col-sm-9">@p.CreatedText</dd>
        </dl>
        <p id="person-regions" class="mt-3 mb-0">@p.RegionsText</p>
        @if (p.CanSuspend || p.CanUnsuspend)
        {
            <form method="post" action="@(p.CanSuspend ? "/people?handler=Suspend" : "/people?handler=Unsuspend")" asp-antiforgery="true" class="mt-3">
                <input type="hidden" name="name" value="@p.FullName">
                @if (p.CanSuspend)
                {
                    <button type="submit" class="btn btn-outline-danger">Suspend</button>
                    <span class="hint form-text ms-2">They get their level back when you unsuspend them.</span>
                }
                else
                {
                    <button type="submit" class="btn btn-outline-primary">Unsuspend</button>
                }
            </form>
        }
    </section>
}
