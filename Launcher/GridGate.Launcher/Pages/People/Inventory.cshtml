@page "/people/{id:guid}/inventory"
@model GridGate.Launcher.Pages.People.InventoryModel
@using GridGate.Launcher.Core.Security
@using GridGate.Launcher.Pages.People
@{
    ViewData["Title"] = "Inventory";
    var id = Model.Person?.Row.Account.PrincipalId;
}
<p><a href="/people/@id">‹ @(Model.Person?.FullName ?? "Person")</a></p>
<h1>Inventory@(Model.Person is { } who ? $": {who.FullName}" : "")</h1>
<error-box text="@Model.Error" />
@if (Model.Person is not null && Model.Error is null)
{
    <p class="text-body-secondary">Item names, types and creators only: what an item contains is never shown here.</p>
    <form id="inventory-search" method="get" action="/people/@id/inventory" class="mb-3">
        <label class="form-label" for="q">Find an item by name, in every folder (Trash too)</label>
        <div class="input-group">
            <input class="form-control" id="q" name="q" value="@Model.Q" maxlength="64" autocomplete="off" spellcheck="false">
            <button type="submit" class="btn btn-primary">Search</button>
        </div>
    </form>
    @if (Model.Q is null)
    {
        <nav aria-label="Folder" id="inventory-path">
            @for (var i = 0; i < Model.Path.Count; i++)
            {
                var f = Model.Path[i];
                if (i > 0) { <span> / </span> }
                if (i == Model.Path.Count - 1) { <strong>@InventoryModel.FolderName(f)</strong> }
                else { <a href="/people/@id/inventory?folder=@f.Id">@InventoryModel.FolderName(f)</a> }
            }
        </nav>
        <ul id="inventory-folders" class="list-unstyled mt-2">
            @foreach (var f in Model.Subfolders)
            {
                <li><a href="/people/@id/inventory?folder=@f.Id">@f.Name</a></li>
            }
        </ul>
    }
    else
    {
        <p><a href="/people/@id/inventory">Back to the folders</a></p>
    }
    <form method="get" action="/people/@id/takedown">
        <div class="table-responsive">
            <table id="inventory-items" class="table table-sm align-middle">
                <thead><tr><th><span class="visually-hidden">Pick</span></th><th>Name</th><th>Type</th><th>Creator</th><th>Created</th>@if (Model.Q is not null) { <th>Folder</th> }</tr></thead>
                <tbody>
                    @foreach (var item in Model.Items)
                    {
                        var r = item.Row;
                        <tr>
                            <td><input class="form-check-input" type="checkbox" name="items" value="@r.ItemId" aria-label="Pick @r.Name"></td>
                            <td>@r.Name</td>
                            <td>@TakedownRules.TypeWords(r.AssetType)</td>
                            <td>@item.CreatorName</td>
                            <td>@TakedownAccess.Day(r.CreationDate)</td>
                            @if (Model.Q is not null) { <td>@item.FolderPath</td> }
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        @if (Model.Items.Count == 0)
        {
            <p class="text-body-secondary">No items here.</p>
        }
        else
        {
            <button type="submit" class="btn btn-danger">Take down selected</button>
        }
    </form>
    <div class="d-flex gap-2 mt-3">
        @if (Model.PageNumber > 1)
        {
            <a class="btn btn-outline-secondary" href="/people/@id/inventory?folder=@Model.Folder?.Id&q=@Model.Q&page=@(Model.PageNumber - 1)">Previous</a>
        }
        @if (Model.HasMore)
        {
            <a class="btn btn-outline-secondary" href="/people/@id/inventory?folder=@Model.Folder?.Id&q=@Model.Q&page=@(Model.PageNumber + 1)">Next</a>
        }
    </div>
}
