@page "/logs"
@model LogsModel
@{
    ViewData["Title"] = "Logs";
    ViewData["Wide"] = true;
}
<div class="page-head">
    <h1>Logs<help-tip class="help-start">What the launcher, Robust and your regions wrote, newest at the bottom. Pick a log and how much to show, then press Show. Tick the box to keep it up to date while you watch.</help-tip></h1>
</div>
<section class="work-panel">
    <form method="get" action="/logs" class="log-controls panel-tools">
        <label class="log-pick">Log
            <select class="form-select form-select-sm" name="source" id="log-source">
                @foreach (var s in Model.Sources)
                {
                    <option value="@s" selected="@(s == Model.Source)">@s</option>
                }
            </select>
        </label>
        <label class="log-pick">Show
            <select class="form-select form-select-sm" name="level" id="log-level">
                <option value="" selected="@(Model.Level == "")">Everything</option>
                <option value="INFO" selected="@(Model.Level == "INFO")">Info and above</option>
                <option value="WARN" selected="@(Model.Level == "WARN")">Warnings and errors</option>
                <option value="ERROR" selected="@(Model.Level == "ERROR")">Errors only</option>
            </select>
        </label>
        <button type="submit" class="btn btn-sm btn-primary" icon="eye">Show</button>
        <div class="form-check ms-auto mb-0"><input class="form-check-input" type="checkbox" id="log-auto"><label class="form-check-label log-auto" for="log-auto">Refresh every 5 seconds</label></div>
    </form>
    <p class="text-body-secondary small mb-2" id="log-note">@(Model.Tail.Truncated ? "Showing the last " + Model.Tail.Lines.Count + " lines." : "")</p>
    <pre id="log-lines" class="log-lines mb-0">@string.Join('\n', Model.Tail.Lines)</pre>
</section>

@section Scripts {
<script src="/js/logs.js"></script>
}
