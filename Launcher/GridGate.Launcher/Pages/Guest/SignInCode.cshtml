@page "/guest/sign-in/code"
@model GridGate.Launcher.Pages.Guest.SignInCodeModel
@{
    ViewData["Title"] = T["SignInCode.Title"].Value;
}
<div class="card card-body shadow-sm mx-auto sign-in-card">
<h1>@T["SignInCode.Title"]</h1>
<p>@T["SignInCode.Intro"]</p>
@if (Model.Error is not null)
{
    <div class="error-box error alert alert-danger" role="alert">@Model.Error</div>
}
@if (Model.TwoFactorUnknown)
{
    <div class="error-box error alert alert-danger" role="alert">@T["SignIn.CodeUnknown"]</div>
}
<form method="post">
    <label class="form-label mt-3" asp-for="Code">@T["SignIn.Code"]</label>
    <input class="form-control" asp-for="Code" value="" maxlength="32" autocomplete="one-time-code" inputmode="text" autofocus required>
    <button type="submit" class="btn btn-primary w-100 mt-4">@T["Common.SignIn"]</button>
</form>
<p class="mt-3 mb-0"><a href="/guest/sign-in">@T["SignInCode.StartAgain"]</a></p>
</div>
