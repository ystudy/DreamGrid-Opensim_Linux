@page "/guest/two-factor"
@model GridGate.Launcher.Pages.Guest.TwoFactorModel
@using GridGate.Launcher.Core.Security
@{
    ViewData["Title"] = T["Common.TwoFactorSignIn"].Value;
}
<h1>@T["Common.TwoFactorSignIn"]</h1>
<p>@T["TwoFactor.Intro"]</p>
<error-box text="@Model.Error" />
@if (Model.Notice is not null)
{
    <div class="alert alert-info" role="status">@Model.Notice</div>
}
@if (Model.State == TwoFactorState.Unknown)
{
    <div class="alert alert-danger" role="alert">@T["SignIn.CodeUnknown"]</div>
}
else if (Model.BackupCodes is { } codes)
{
    <div class="alert alert-success" role="status">@T["TwoFactor.IsOn"]</div>
    <h2>@T["TwoFactor.BackupCodes"]</h2>
    <p>@T["TwoFactor.BackupCodesIntro"]</p>
    <ul id="backup-codes" class="backup-codes list-unstyled">
        @foreach (var c in codes)
        {
            <li>@c</li>
        }
    </ul>
    <p><a class="btn btn-primary" href="/guest">@T["Common.Continue"]</a></p>
}
else if (Model.State == TwoFactorState.Off)
{
    <p>@T["TwoFactor.IsOff"]</p>
    @if (Model.QrSvg is not null)
    {
        <h2>@T["TwoFactor.TurnItOn"]</h2>
        <p>@T["TwoFactor.ScanIntro"]</p>
        <div class="two-factor-qr mb-3" role="img" aria-label="@T["TwoFactor.QrLabel"]">@Html.Raw(Model.QrSvg)</div>
        <p>@T["TwoFactor.CantScan"] <code id="two-factor-secret">@Model.SecretText</code></p>
        <form id="turn-on" method="post" asp-page-handler="TurnOn" class="mb-4">
            <input type="hidden" name="Shown" value="@Model.Shown">
            <label class="form-label" for="turn-on-code">@T["SignIn.Code"]</label>
            <input class="form-control mb-3 code-input" id="turn-on-code" name="Code" value="" maxlength="32" autocomplete="one-time-code" inputmode="numeric" required>
            <button type="submit" class="btn btn-primary">@T["TwoFactor.TurnOn"]</button>
        </form>
    }
}
else
{
    <div class="alert alert-success" role="status">@T["TwoFactor.IsOn"]</div>
    <h2>@T["TwoFactor.NewCodes"]</h2>
    <p>@T["TwoFactor.NewCodesIntro"]</p>
    <form id="new-codes" method="post" asp-page-handler="NewCodes" class="mb-4">
        <label class="form-label" for="new-codes-code">@T["SignIn.Code"]</label>
        <input class="form-control mb-3 code-input" id="new-codes-code" name="Code" value="" maxlength="32" autocomplete="one-time-code" inputmode="numeric" required>
        <button type="submit" class="btn btn-outline-primary">@T["TwoFactor.NewCodes"]</button>
    </form>
    <h2>@T["TwoFactor.TurnOff"]</h2>
    <p>@T["TwoFactor.TurnOffIntro"]</p>
    <form id="turn-off" method="post" asp-page-handler="TurnOff">
        <label class="form-label" for="turn-off-code">@T["SignIn.Code"]</label>
        <input class="form-control mb-3 code-input" id="turn-off-code" name="Code" value="" maxlength="32" autocomplete="one-time-code" required>
        <button type="submit" class="btn btn-danger">@T["TwoFactor.TurnOff"]</button>
    </form>
}
<p class="mt-4"><a href="/guest">@T["Common.BackToAccount"]</a></p>
