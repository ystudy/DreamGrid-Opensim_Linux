@page "/guest/forgot-password"
@model GridGate.Launcher.Pages.Guest.ForgotPasswordModel
@{
    ViewData["Title"] = T["ForgotPassword.Title"].Value;
}
<div class="card card-body shadow-sm mx-auto sign-in-card">
<h1>@T["ForgotPassword.Title"]</h1>
@if (Model.Off)
{
    <p id="reset-off">@T["ForgotPassword.Off"]</p>
}
else if (Model.Sent)
{
    <p id="reset-reply" role="status">@T["ForgotPassword.Reply"]</p>
    <p class="mb-0"><a href="/guest/sign-in">@T["Common.BackToSignIn"]</a></p>
}
else
{
    <p class="tone-text">@T["ForgotPassword.Intro"]</p>
    @if (Model.Error is not null)
    {
        <div class="error-box error alert alert-danger" role="alert">@Model.Error</div>
    }
    <form id="forgot" method="post">
        <label class="form-label mt-3" asp-for="Name">@T["Common.AvatarName"]</label>
        <input class="form-control" asp-for="Name" maxlength="64" autocomplete="username" placeholder="@T["Common.NamePlaceholder"]" required>
        <label class="form-label mt-3" asp-for="Email">@T["Common.Email"]</label>
        <input class="form-control" asp-for="Email" type="email" maxlength="254" autocomplete="email" required>
        <partial name="_BotFields" />
        <button type="submit" class="btn btn-primary w-100 mt-4">@T["Common.SendLink"]</button>
    </form>
    <p class="mt-3 mb-0"><a href="/guest/sign-in">@T["Common.BackToSignIn"]</a></p>
}
</div>
