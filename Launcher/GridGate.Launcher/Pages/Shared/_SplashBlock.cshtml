@using GridGate.Launcher.Core.Guests
@using GridGate.Launcher.Core.Security
@using GridGate.Launcher.Core.Splash
@model GridGate.Launcher.Splash.SplashBlockView
@{
    var b = Model.Block;
    var c = b.Content;
    var s = Model.Settings;
    var status = Model.Status;
    var guestSide = AdminRule.HasStaffPages(s);
    var links = c.Links;
    static string En(IReadOnlyDictionary<string, string>? text) => text is not null && text.TryGetValue("en", out var t) ? t : "";
    var language = GridGate.Launcher.Resident.ResidentLanguageFilter.Current(Context);
}
@* One block of the splash page. Owner text goes through the Legal pages' Markdown, which shows any HTML as text. *@
<div class="splash-block splash-kind-@b.Kind.ToString().ToLowerInvariant() @SplashCss.ClassOf(b)" data-block-id="@b.Id">
    @switch (b.Kind)
    {
        case SplashBlockKind.Text:
            @Html.Raw(LegalMarkdown.ToHtml(En(c.Text)))
            break;
        case SplashBlockKind.GridName:
            <div class="splash-name">
                @if (c.ShowLogo && Model.Logo is { } logo)
                {
                    <img class="splash-logo" src="@GridGate.Launcher.Splash.SplashSnapshot.LogoUrl(logo)" alt="@s.GridName">
                }
                @if (c.ShowName)
                {
                    <div class="splash-heading">@s.GridName</div>
                }
            </div>
            break;
        case SplashBlockKind.Status:
            <ul class="splash-list">
                @if (c.Status?.Online == true)
                {
                    <li>@(status.GridOnline ? T["Welcome.Online"] : T["Welcome.Offline"])</li>
                }
                @if (c.Status?.People == true)
                {
                    <li>@(status.PeopleOnline is { } p ? (p == 1 ? T["Welcome.OnePersonOnline"] : T["Welcome.PeopleOnline", p]) : T["Welcome.StatusUnavailable"])</li>
                }
                @if (c.Status?.Regions == true)
                {
                    <li>@(status.RegionsRunning is { } r ? (r == 1 ? T["Welcome.OneRegion"] : T["Welcome.Regions", r]) : T["Welcome.StatusUnavailable"])</li>
                }
            </ul>
            break;
        case SplashBlockKind.News:
            if (En(c.Heading) is { Length: > 0 } heading)
            {
                <div class="splash-heading">@heading</div>
            }
            <ul class="splash-list">
                @foreach (var item in (c.News ?? []).Where(n => !n.Hidden).OrderByDescending(n => n.Date))
                {
                    <li>
                        <span class="splash-news-date">@item.Date.ToString("d MMMM yyyy", System.Globalization.CultureInfo.CurrentCulture)</span>
                        @Html.Raw(LegalMarkdown.ToHtml(En(item.Text)))
                    </li>
                }
            </ul>
            break;
        case SplashBlockKind.Places:
            <ul class="splash-list splash-places">
                @for (var i = 0; i < (c.Places?.Count ?? 0); i++)
                {
                    var place = c.Places![i];
                    <li>
                        @if (place.Picture is not null)
                        {
                            <div class="splash-place-picture @SplashCss.PlaceClassOf(b, i)" role="img" aria-label="@place.RegionName"></div>
                        }
                        <span class="splash-place-name">@place.RegionName</span> @En(place.Line)
                    </li>
                }
            </ul>
            break;
        case SplashBlockKind.Picture:
            <div class="splash-picture @SplashCss.PictureClassOf(b)" role="img" aria-label="@(En(c.Caption) is { Length: > 0 } label ? label : T["Welcome.Picture"].Value)"></div>
            if (En(c.Caption) is { Length: > 0 } caption)
            {
                <div class="splash-caption">@caption</div>
            }
            break;
        case SplashBlockKind.Links:
            <nav class="splash-links">
                @if (links?.SignUp == true && guestSide && SignUpRules.IsOpen(s))
                {
                    <a href="/signup">@T["Common.CreateAccount"]</a>
                }
                @if (links?.ForgotPassword == true && guestSide)
                {
                    <a href="/guest/forgot-password">@T["Welcome.ForgotPassword"]</a>
                }
                @if (links?.Terms == true && guestSide && LegalPages.Get(s, LegalPages.Terms, language) is not null)
                {
                    <a href="/terms">@T["Legal.Terms"]</a>
                }
                @if (links?.Privacy == true && guestSide && LegalPages.Get(s, LegalPages.Privacy, language) is not null)
                {
                    <a href="/privacy">@T["Legal.Privacy"]</a>
                }
                @if (links?.FrontPage == true && guestSide)
                {
                    <a href="/home">@T["Welcome.AboutGrid"]</a>
                }
            </nav>
            break;
    }
</div>
