@page "/security/starter-avatars"
@model GridGate.Launcher.Pages.Security.StarterAvatarsModel
@{
    ViewData["Title"] = "Starter avatars";
}
@section Head {
    @if (Model.Progress is { Running: true })
    {
        <meta http-equiv="refresh" content="3">
    }
}
<p class="back-link"><a href="/guest-pages">‹ Guest pages</a></p>
<h1>Starter avatars</h1>
<p>New residents choose one of these on the second step of signing up, and log in wearing it with copies of everything it wears in their inventory. An avatar is on the sign-up page once it has a snapshot and its model passed <strong>Check it</strong>.</p>
<error-box text="@Model.Error" />
<ok-box text="@Model.Notice" />

@if (Model.LoginShown is { } login)
{
    <section class="card card-body mb-3 border-primary" id="model-login">
        <h2 class="h5">Log in as @login.Avatar's model</h2>
        <p class="mb-1">Name: <code>@login.ModelName</code></p>
        <p>Password: <code class="model-password">@login.Password</code> (shown only now)</p>
        <p class="mb-0">Log in with a viewer, open the folder <strong>@login.Folder</strong> in your inventory, choose Replace Outfit, wait until you look right, then log out. Then press <strong>Check it</strong>.</p>
    </section>
}
@if (Model.CheckShown is { } check)
{
    <section class="card card-body mb-3" id="check-result">
        <h2 class="h5">@check.Avatar: @(check.Result.Passed ? "the check passed" : "the check failed")</h2>
        @if (check.Result.Missing.Count > 0)
        {
            <p class="mb-1">Missing from the model's inventory, or not stored:</p>
            <ul>@foreach (var m in check.Result.Missing) { <li>@m</li> }</ul>
        }
        @if (check.Result.PermissionWarnings.Count > 0)
        {
            <p class="mb-1">Residents get these with limited permissions:</p>
            <ul class="mb-0">@foreach (var w in check.Result.PermissionWarnings) { <li>@w</li> }</ul>
        }
    </section>
}
@if (Model.Progress is { } progress)
{
    <section class="card card-body mb-3" id="import-progress">
        <h2 class="h5">@(progress.Running ? "Loading avatars…" : "Loading finished")</h2>
        <ul class="list-unstyled mb-0">
            @foreach (var line in progress.Lines)
            {
                <li>@line.Name: @line.Stage@if (line.Error is not null) { <span class="text-danger"> — @line.Error</span> }</li>
            }
        </ul>
    </section>
}

@if (Model.Candidates.Count > 0)
{
    <section class="card card-body mb-3" id="archive-picks">
        <h2 class="h5">Avatars in the archive</h2>
        <p class="small">Tick the ones to add. Each gets its own model account, and its folder is loaded into it. Taken-down items are left out.</p>
        <form method="post" asp-page-handler="Import">
            <input type="hidden" name="Pending" value="@Model.Pending">
            @for (var i = 0; i < Model.Candidates.Count; i++)
            {
                var c = Model.Candidates[i];
                <div class="d-flex flex-wrap gap-2 align-items-center mb-2">
                    <input type="hidden" name="Picks[@i].Folder" value="@c.FolderPath">
                    <input class="form-check-input" type="checkbox" name="Picks[@i].On" value="true" id="pick-@i" checked>
                    <label class="form-check-label small" for="pick-@i">@c.FolderPath (@c.Items items)</label>
                    <label class="visually-hidden" for="pick-name-@i">Name for @c.FolderPath</label>
                    <input class="form-control form-control-sm w-auto" id="pick-name-@i" name="Picks[@i].Name" value="@c.Name" maxlength="@StarterAvatarsModel.MaxName" required>
                </div>
            }
            <button class="btn btn-primary" type="submit">Add the ticked avatars</button>
        </form>
    </section>
}
else if (Model.Pending is null)
{
    <section class="card card-body mb-3" id="archive-upload">
        <h2 class="h5">Load avatars from an archive</h2>
        <form method="post" action="/security/starter-avatars/upload" enctype="multipart/form-data" asp-antiforgery="true">
            <label class="form-label" for="iar-file">An IAR whose avatars are folders two levels down, such as FULLAVATARS/Lyra (no size limit)</label>
            <input class="form-control" type="file" id="iar-file" name="iar" accept=".iar" required>
            <button type="submit" class="btn btn-outline-primary mt-2">Upload</button>
        </form>
        <details class="mt-3">
            <summary>Or add an account you already dressed</summary>
            <form method="post" asp-page-handler="AddExisting" class="row g-2 mt-1">
                <div class="col-auto"><label class="form-label small" for="add-first">First name</label><input class="form-control form-control-sm" id="add-first" name="first" required></div>
                <div class="col-auto"><label class="form-label small" for="add-last">Last name</label><input class="form-control form-control-sm" id="add-last" name="last" required></div>
                <div class="col-auto"><label class="form-label small" for="add-name">Name at sign-up</label><input class="form-control form-control-sm" id="add-name" name="name" maxlength="@StarterAvatarsModel.MaxName"></div>
                <div class="col-auto align-self-end"><button class="btn btn-sm btn-outline-primary" type="submit">Add</button></div>
            </form>
        </details>
    </section>
}

@if (Model.Avatars.Count == 0)
{
    <p class="text-body-secondary">There are no starter avatars yet, so new residents get the plain avatar.</p>
}
@for (var i = 0; i < Model.Avatars.Count; i++)
{
    var a = Model.Avatars[i];
    <section class="card card-body mb-3 starter-row" id="avatar-@a.Id.ToString("N")">
        <div class="d-flex flex-wrap gap-3">
            <div class="starter-thumb">
                @if (a.Snapshot is not null)
                {
                    <img class="img-fluid rounded border" src="/security/starter-avatars?handler=Picture&id=@a.Id" alt="@a.Name">
                }
                else
                {
                    <div class="border rounded text-center text-body-secondary p-3 small">No snapshot</div>
                }
            </div>
            <div class="flex-grow-1">
                <h2 class="h5 mb-1">@a.Name @if (a.Id == Model.EffectiveDefault) { <span class="badge text-bg-primary">Default</span> }</h2>
                <p class="small text-body-secondary mb-2">Model account: @a.ModelName · @StarterAvatarsModel.Status(a)</p>
                <ul class="list-unstyled small mb-2">
                    <li>@(a.Snapshot is not null ? "✓" : "✗") Snapshot</li>
                    <li>@(a.CheckPassed ? "✓" : "✗") Worn and checked@(a.CheckedAt is { } at ? $" ({at.UtcDateTime:yyyy-MM-dd HH:mm} UTC)" : "")</li>
                    <li>@(a.IsReady ? "✓" : "✗") Ready</li>
                </ul>
                @if (a.Warning is not null)
                {
                    <div class="alert alert-warning py-2 small" role="alert">@a.Warning</div>
                }
                <div class="d-flex flex-wrap gap-2 mb-2">
                    <form method="post" asp-page-handler="Login"><input type="hidden" name="id" value="@a.Id"><button class="btn btn-sm btn-outline-primary" type="submit">Log in as this model</button></form>
                    <form method="post" asp-page-handler="Check"><input type="hidden" name="id" value="@a.Id"><button class="btn btn-sm btn-primary" type="submit">Check it</button></form>
                </div>
                <form method="post" asp-page-handler="Snapshot" enctype="multipart/form-data" class="d-flex flex-wrap gap-2 align-items-center mb-2">
                    <input type="hidden" name="id" value="@a.Id">
                    <label class="visually-hidden" for="file-@a.Id">Snapshot for @a.Name</label>
                    <input class="form-control form-control-sm w-auto" type="file" id="file-@a.Id" name="file" accept="image/png,image/jpeg,image/webp" required>
                    <button class="btn btn-sm btn-outline-primary" type="submit">Upload snapshot</button>
                </form>
                <form method="post" asp-page-handler="Rename" class="d-flex flex-wrap gap-2 align-items-center mb-2">
                    <input type="hidden" name="id" value="@a.Id">
                    <label class="visually-hidden" for="name-@a.Id">Name of @a.Name</label>
                    <input class="form-control form-control-sm w-auto" id="name-@a.Id" name="name" value="@a.Name" maxlength="@StarterAvatarsModel.MaxName" required>
                    <button class="btn btn-sm btn-outline-secondary" type="submit">Rename</button>
                </form>
                <div class="d-flex flex-wrap gap-2">
                    <form method="post" asp-page-handler="Move"><input type="hidden" name="id" value="@a.Id"><input type="hidden" name="delta" value="-1"><button class="btn btn-sm btn-outline-secondary" type="submit" disabled="@(i == 0)">Move up</button></form>
                    <form method="post" asp-page-handler="Move"><input type="hidden" name="id" value="@a.Id"><input type="hidden" name="delta" value="1"><button class="btn btn-sm btn-outline-secondary" type="submit" disabled="@(i == Model.Avatars.Count - 1)">Move down</button></form>
                    <form method="post" asp-page-handler="Default"><input type="hidden" name="id" value="@a.Id"><button class="btn btn-sm btn-outline-secondary" type="submit" disabled="@(a.Id == Model.DefaultId)">Make default</button></form>
                    @if (a.Hidden)
                    {
                        <form method="post" asp-page-handler="Show"><input type="hidden" name="id" value="@a.Id"><button class="btn btn-sm btn-outline-secondary" type="submit">Show at sign-up</button></form>
                    }
                    else
                    {
                        <form method="post" asp-page-handler="Hide"><input type="hidden" name="id" value="@a.Id"><button class="btn btn-sm btn-outline-secondary" type="submit">Hide from sign-up</button></form>
                    }
                    <form method="post" asp-page-handler="Remove" data-confirm="Take @a.Name off the list? Residents who picked it keep their copies.">
                        <input type="hidden" name="id" value="@a.Id">
                        <div class="form-check form-check-inline small">
                            <input class="form-check-input" type="checkbox" name="deleteModel" value="true" id="del-@a.Id">
                            <label class="form-check-label" for="del-@a.Id">also delete its model account</label>
                        </div>
                        <button class="btn btn-sm btn-outline-danger" type="submit">Remove</button>
                    </form>
                </div>
            </div>
        </div>
    </section>
}
<script src="/js/confirm.js"></script>
