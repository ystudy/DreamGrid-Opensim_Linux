@page "/staff"
@model GridGate.Launcher.Pages.Staff.IndexModel
@using GridGate.Launcher.Core.Security
@{
    ViewData["Title"] = "Staff";
    ViewData["Wide"] = true;
    static string RoleName(StaffRole role) => role switch
    {
        StaffRole.Owner => "Owner",
        StaffRole.Admin => "Admin",
        StaffRole.Supervisor => "Supervisor",
        _ => "Guest",
    };
}
<div class="page-head">
    <h1>Staff<help-tip class="help-start">Admins can use every page. Supervisors can only look people up and suspend guests. Changes here take effect at once, and a person who loses their role is signed out.</help-tip></h1>
</div>
@if (Model.Error is not null)
{
    <div class="error-box error alert alert-danger" role="alert">@Model.Error</div>
}
@if (Model.Notice is not null)
{
    <div class="ok-box alert alert-success" role="status">@Model.Notice</div>
}
@if (Model.Unavailable)
{
    <p id="staff-unavailable">Start your world to see and change staff.</p>
}
else
{
    <div class="list-columns">
        <section class="work-panel" aria-labelledby="staff-title">
            <h2 id="staff-title" class="panel-title">Staff<span class="badge text-bg-secondary ms-2">@Model.Rows.Count</span></h2>
            <div class="table-responsive">
                <table id="staff-people" class="table align-middle mb-0">
                    <thead><tr><th>Name</th><th>Role</th><th>Level</th><th></th></tr></thead>
                    <tbody>
                    @foreach (var p in Model.Rows)
                    {
                        <tr data-person="@p.Name">
                            <td class="fw-semibold">@p.Name</td>
                            <td>@RoleName(p.Role)</td>
                            <td>@p.Level</td>
                            <td>
                                @if (p.Role != StaffRole.Owner)
                                {
                                    <form method="post" action="/staff?handler=Change" asp-antiforgery="true" class="d-flex flex-wrap gap-2 justify-content-end">
                                        <input type="hidden" name="name" value="@p.Name">
                                        @if (p.Role != StaffRole.Admin)
                                        {
                                            <button type="submit" name="change" value="MakeAdmin" class="btn btn-sm btn-outline-primary" icon="key">Make admin</button>
                                        }
                                        @if (p.Role != StaffRole.Supervisor)
                                        {
                                            <button type="submit" name="change" value="MakeSupervisor" class="btn btn-sm btn-outline-primary" icon="eye">Make supervisor</button>
                                        }
                                        <button type="submit" name="change" value="MakeGuest" class="btn btn-sm btn-outline-danger" icon="person">Make guest</button>
                                    </form>
                                }
                            </td>
                        </tr>
                    }
                    </tbody>
                </table>
            </div>
        </section>

        <section class="work-panel" aria-labelledby="staff-add-title">
            <h2 id="staff-add-title" class="panel-title">Add someone</h2>
            <form id="staff-add" method="post" action="/staff?handler=Change" asp-antiforgery="true">
                <label class="form-label" for="Name">Avatar name</label>
                <input class="form-control" id="Name" name="name" value="@Model.Typed" autocomplete="off" autocapitalize="off" spellcheck="false" placeholder="First Last">
                <p class="hint form-text">Type the first and last name of an avatar on your grid.</p>
                <div class="d-grid gap-2">
                    <button type="submit" name="change" value="MakeSupervisor" class="btn btn-primary" icon="eye">Make supervisor</button>
                    <button type="submit" name="change" value="MakeAdmin" class="btn btn-primary" icon="key">Make admin</button>
                </div>
            </form>
        </section>
    </div>
}
