@page "/"
@model IndexModel
@{
    ViewData["Title"] = "Your world";
    ViewData["Wide"] = true;
    var g = Model.Status.Grid;
    var parts = new[] { g.Database, g.Robust };
    var c = Model.Dashboard.Counts;
    var regionsRunning = g.Regions.Count(r => r.State == "Running");
    var regionsParked = g.Regions.Count(r => r.State == "Parked");
    var here = Model.ThisComputerOnly ? " (on this computer)" : "";
}
@* The world's controls sit in the heading row, so they are the first thing on the page. *@
<div class="page-head">
    <h1>Your world</h1>
    <form id="controls" class="page-actions home-controls" method="post" action="/dashboard?handler=run" asp-antiforgery="true">
        <button type="submit" name="gridAction" value="restart-database" class="btn btn-outline-secondary" icon="restart">Restart the database</button>
        @if (Model.RunsRobust)
        {
            <button type="submit" name="gridAction" value="restart-robust" class="btn btn-outline-secondary" icon="restart">Restart the grid service</button>
        }
        @* The world's power menu (spec 6.8): a <details> element, so it opens without JavaScript. *@
        <details class="power-menu power-menu-end">
            <summary class="btn btn-primary">Power</summary>
            <div class="power-items list-group shadow">
                <div class="list-group-item">
                    <button type="submit" name="gridAction" value="start" class="btn btn-link p-0 fw-semibold">Start</button>
                    <span class="form-text d-block m-0">Every region except parked ones.</span>
                </div>
                <div class="list-group-item">
                    <button type="submit" name="gridAction" value="start-everything" class="btn btn-link p-0 fw-semibold">Start everything</button>
                    <span class="form-text d-block m-0">Parked regions too; they stop being parked.</span>
                </div>
                <div class="list-group-item">
                    <button type="submit" name="gridAction" value="restart" class="btn btn-link p-0 fw-semibold">Restart</button>
                    <span class="form-text d-block m-0">Every running region@(Model.RunsRobust ? ", the grid service" : "") and the database.</span>
                </div>
                <div class="list-group-item">
                    <button type="submit" name="gridAction" value="stop" class="btn btn-link p-0 fw-semibold">Stop all</button>
                    <span class="form-text d-block m-0">Everything goes offline. Parked regions stay parked.</span>
                </div>
            </div>
        </details>
    </form>
</div>
<p id="notice" class="notice alert alert-info mb-3 py-2" role="status">@Model.Notice</p>
<partial name="_PlainHttpWarning" />
@if (Model.EmailWarnings.Count > 0)
{
    <div id="email-warnings">
    @if (Model.IsOwner)
    {
        <partial name="_EmailWarnings" model="Model.EmailWarnings" />
        <p><a href="/security/email">Open the Email page</a></p>
    }
    else
    {
        <div class="alert alert-warning" role="alert">Email has a problem — the grid owner can fix it on the Email page.</div>
    }
    </div>
}
<partial name="_NewTexts" model="Model.NewTexts" />

<section id="tiles" class="panel mb-3" aria-label="At a glance">
    <div class="tiles">
        @* Only where this computer's robust database is the grid's: elsewhere its Presence is empty and this would always be 0. *@
        @if (Model.GridHere)
        {
            <div class="tile" data-tile="online">
                <div class="tile-label">In-world now</div>
                <div class="tile-number" id="tile-online">@Model.Status.Online.Count</div>
                <div class="tile-sub">Signed in today: <span data-n="signedInToday">@IndexModel.N(c.SignedInToday)</span> · this month: <span data-n="signedInThisMonth">@IndexModel.N(c.SignedInThisMonth)</span></div>
            </div>
        }
        <div class="tile" data-tile="regions">
            <div class="tile-label">Regions</div>
            <div class="tile-number" id="tile-regions">@regionsRunning of @g.Regions.Count</div>
            <div class="tile-sub" id="tile-regions-sub">running · @regionsParked parked</div>
        </div>
        @if (Model.GridHere)
        {
            <div class="tile" data-tile="residents">
                <div class="tile-label">Residents</div>
                <div class="tile-number" data-n="residents">@IndexModel.N(c.Residents)</div>
                <div class="tile-sub">Joined this month: <span data-n="joinedThisMonth">@IndexModel.N(c.JoinedThisMonth)</span> · never signed in: <span data-n="neverSignedIn">@IndexModel.N(c.NeverSignedIn)</span></div>
            </div>
            <div class="tile" data-tile="land">
                <div class="tile-label">Land</div>
                <div class="tile-number"><span data-km2="landSquareMetres">@IndexModel.Km2(c.LandSquareMetres)</span> km²</div>
                <div class="tile-sub"><span data-n="mapRegions">@IndexModel.N(c.MapRegions)</span> regions on the map</div>
            </div>
        }
        @if (Model.SignUps is not null)
        {
            <div class="tile" data-tile="signups">
                <div class="tile-label">Sign-ups</div>
                <div class="tile-number">@Model.SignUpsWaiting</div>
                <div class="tile-sub">waiting</div>
            </div>
        }
    </div>
</section>

@* Three columns: is it working | where people are | what the world holds. *@
<div class="home-columns mb-3">
<div class="home-col">
    <section class="panel">
        <div class="panel-head"><h2>Core services</h2></div>
        <p id="headline" class="headline@(Model.Status.Problem is null ? "" : " problem")">@Model.Status.Headline</p>
        <ul id="components" class="components panel-rows">
            @foreach (var part in parts)
            {
                <li>
                    <span><span class="component-label">@part.Label</span> <span class="row-sub">@part.Detail</span></span>
                    <span class="badge state-@part.State.ToLowerInvariant() ms-auto">@part.StateText</span>
                </li>
            }
        </ul>
        <ul id="checks" class="panel-rows">
            @foreach (var check in Model.Dashboard.Checks)
            {
                <li>
                    <span><span class="component-label">@check.Name</span> <span class="row-sub">@check.Detail</span></span>
                    <span class="ms-auto row-sub">@(check.Milliseconds is { } ms ? ms + " ms" : "")</span>
                    <span class="badge @IndexModel.CheckClass(check.State)">@IndexModel.CheckText(check.State)</span>
                </li>
            }
        </ul>
        <ul class="panel-rows">
            <li id="website-row">
                <span><span class="component-label">Website</span> <span class="row-sub">this page</span></span>
                @if (HttpContext.Request.IsHttps)
                {
                    <span class="badge state-running ms-auto">Working</span>
                }
                else
                {
                    <span class="badge state-starting ms-auto">Not https</span>
                }
            </li>
        </ul>
        @if (Model.FailedLogs.Count > 0)
        {
            <details class="failed-details mt-2">
                <summary>Show details</summary>
                @foreach (var (label, lines) in Model.FailedLogs)
                {
                    <p class="component-label">@label</p>
                    <pre>@string.Join('\n', lines)</pre>
                }
            </details>
        }
    </section>
    <section class="panel">
        <div class="panel-head"><h2>Connect</h2></div>
        <p class="form-text">Your world's address, for the Grid Manager in Firestorm:</p>
        <div class="input-group copy-row">
            <code id="login-uri" class="form-control login-uri">@g.LoginUri</code>
            <button type="button" id="copy-uri" class="btn btn-outline-primary" hidden>Copy</button>
        </div>
    </section>
@if (Model.Switches.Count > 0)
{
    <section id="features" class="panel">
        <h2>Features</h2>
        <ul class="features list-group list-group-flush">
            @foreach (var (sw, on) in Model.Switches)
            {
                <li class="list-group-item px-0 d-flex flex-wrap align-items-center gap-2">
                    <span class="component-label">@sw.Label</span>
                    <span class="badge@(on ? " state-running" : "")">@(on ? "On" : "Off")</span>
                    <span class="form-text m-0 me-auto">@sw.Description</span>
                    <form method="post" action="/dashboard?handler=switch" asp-antiforgery="true" class="m-0">
                        <input type="hidden" name="moduleId" value="@sw.ModuleId">
                        <button type="submit" name="on" value="@(on ? "false" : "true")" class="btn btn-sm btn-outline-primary">@(on ? "Turn off" : "Turn on")</button>
                    </form>
                </li>
            }
        </ul>
    </section>
}
</div>
<div class="home-col">
    <section class="panel">
        <div class="panel-head"><h2>Regions</h2></div>
        <ul id="region-rows" class="panel-rows">
            @foreach (var r in g.Regions)
            {
                <li>
                    <span>
                        @if (r.Id is { } rid)
                        {
                            <a class="component-label" href="/regions?region=@rid">@r.Name</a>
                        }
                        else
                        {
                            <span class="component-label">@r.Name</span>
                        }
                        @if (r.RunsWith is { Count: > 0 } others)
                        {
                            <span class="row-sub">runs with @string.Join(", ", others)</span>
                        }
                    </span>
                    @if (r.People is { } heads)
                    {
                        <span class="ms-auto row-sub">@heads here</span>
                    }
                    <span class="badge state-@r.State.ToLowerInvariant()@(r.People is null ? " ms-auto" : "")">@r.StateText</span>
                </li>
            }
        </ul>
    </section>
    <section class="panel">
        <div class="panel-head"><h2>Who's online</h2></div>
        <ul id="online" class="online panel-rows" data-links="@(Model.GridHere ? "people" : "")" hidden="@(Model.Status.Online.Count == 0)">
            @foreach (var p in Model.Status.OnlinePeople ?? [])
            {
                <li>
                    @if (Model.GridHere && p.Id != Guid.Empty)
                    {
                        <a class="component-label" href="/people/@p.Id">@p.Name</a>
                    }
                    else
                    {
                        <span class="component-label">@p.Name</span>
                    }
                    <span class="ms-auto row-sub">@p.Region</span>
                </li>
            }
        </ul>
        <p id="online-note" class="text-body-secondary mb-0" hidden="@(Model.Status.Online.Count > 0)">
            @(Model.Status.OnlineAvailable ? "Nobody is in-world right now." : "This list shows once the database is running.")
        </p>
    </section>
</div>
<div class="home-col">
@if (Model.SignUps is { } signUps)
{
    <section id="signups-card" class="panel">
        <h2>New sign-ups @if (Model.SignUpsWaiting > 0) { <span class="badge text-bg-warning">@Model.SignUpsWaiting waiting</span> }</h2>
        <partial name="_SignUpRows" model="signUps" />
        <p class="small mt-2 mb-0"><a href="/people/sign-ups">See all sign-ups</a></p>
    </section>
}
    <section class="panel">
        <div class="panel-head"><h2>What's in your world</h2></div>
        <ul id="world-counts" class="panel-rows">
            <li data-count="objects"><span>Objects@(here)</span><span class="ms-auto fw-semibold" data-n="objects">@IndexModel.N(c.Objects)</span></li>
            <li data-count="linked-objects"><span>Linked objects@(here)</span><span class="ms-auto fw-semibold" data-n="linkedObjects">@IndexModel.N(c.LinkedObjects)</span></li>
            <li data-count="parcels"><span>Parcels@(here)</span><span class="ms-auto fw-semibold" data-n="parcels">@IndexModel.N(c.Parcels)</span></li>
            <li data-count="parcels-for-sale"><span>Parcels for sale@(here)</span><span class="ms-auto fw-semibold" data-n="parcelsForSale">@IndexModel.N(c.ParcelsForSale)</span></li>
            <li data-count="estates"><span>Estates@(here)</span><span class="ms-auto fw-semibold" data-n="estates">@IndexModel.N(c.Estates)</span></li>
            @if (Model.GridHere)
            {
                <li data-count="groups"><span>Groups</span><span class="ms-auto fw-semibold" data-n="groups">@IndexModel.N(c.Groups)</span></li>
                <li data-count="hypergrid-links"><span>Hypergrid links</span><span class="ms-auto fw-semibold" data-n="hypergridLinks">@IndexModel.N(c.HypergridLinks)</span></li>
                <li data-count="profiles"><span>Profiles filled in</span><span class="ms-auto fw-semibold" data-n="profiles">@IndexModel.N(c.Profiles)</span></li>
                <li data-count="picks"><span>Profile picks</span><span class="ms-auto fw-semibold" data-n="picks">@IndexModel.N(c.Picks)</span></li>
                <li data-count="classifieds"><span>Classifieds</span><span class="ms-auto fw-semibold" data-n="classifieds">@IndexModel.N(c.Classifieds)</span></li>
            }
        </ul>
    </section>
</div>
</div>

<p class="dashboard-key small text-body-secondary d-flex flex-wrap justify-content-between gap-2">
    <span>Key: <span class="badge state-running">Working</span> <span class="badge state-starting">Check this</span> <span class="badge state-failed">Down</span></span>
    <span>Numbers counted at <time id="checked-at" datetime="@Model.Dashboard.CheckedAt.ToString("O")">@Model.Dashboard.CheckedAt.ToLocalTime().ToString("HH:mm:ss")</time>, once a minute.</span>
</p>

@section Scripts {
<script src="/js/index.js"></script>
}
