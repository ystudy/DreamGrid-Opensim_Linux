<Project Sdk="Microsoft.NET.Sdk">

  <!-- Boots a standalone OpenSim region from a copy of bin/ and checks the paths most likely to break on .NET 10 / Linux.
       No OpenSim project references: it only drives the built bin/. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>GridGate.Smoke</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <!-- Same retired-file rules as the stager, so the sandbox copy of bin/ never boots stale add-on output. -->
    <Compile Include="..\..\Launcher\GridGate.Launcher.Core\Runtime\RetiredFiles.cs" Link="RetiredFiles.cs" />
  </ItemGroup>

</Project>
