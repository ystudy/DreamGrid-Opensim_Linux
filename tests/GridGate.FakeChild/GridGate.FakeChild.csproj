<Project Sdk="Microsoft.NET.Sdk">

  <!-- Stand-in for Robust/OpenSim in the launcher's process tests: crashes, serves /health, or launches another copy of itself. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <!-- Only the launch mode uses it: it starts a serve-mode child through ManagedProcess and exits at once. -->
    <ProjectReference Include="..\..\Launcher\GridGate.Launcher.Core\GridGate.Launcher.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- The import-ok mode answers with the shared fixture report. -->
    <None Include="../fixtures/model-import/report.json" Link="report.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
