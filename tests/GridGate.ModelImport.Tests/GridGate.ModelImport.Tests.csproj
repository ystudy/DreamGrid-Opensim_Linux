<Project Sdk="Microsoft.NET.Sdk">

  <!-- Tests for the GridGate.ModelImport converter. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <EnableUnsafeBinaryFormatterSerialization>true</EnableUnsafeBinaryFormatterSerialization>
  </PropertyGroup>

  <ItemGroup>
    <!-- Runs on Microsoft.Testing.Platform (selected in global.json); no VSTest packages needed. -->
    <PackageReference Include="xunit.v3" Version="4.0.2" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../../OpenSim/Tools/GridGate.ModelImport/GridGate.ModelImport.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include="Models/**" Link="Models/%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <None Include="../fixtures/model-import/*.json" Link="fixtures/model-import/%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
