<Project Sdk="Microsoft.NET.Sdk">

  <!-- Tests for the GridGate.ModelImport converter. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <EnableUnsafeBinaryFormatterSerialization>true</EnableUnsafeBinaryFormatterSerialization>
    <NoWarn>CA1416</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <!-- Runs on Microsoft.Testing.Platform (selected in global.json); no VSTest packages needed. -->
    <PackageReference Include="xunit.v3" Version="4.0.2" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../../OpenSim/Tools/GridGate.ModelImport/GridGate.ModelImport.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- The tests build their own PNG and JPEG images with OpenSim's System.Drawing, as the converter does. -->
    <Reference Include="System.Drawing.Common">
      <HintPath>$(GgRoot)bin\System.Drawing.Common.dll</HintPath>
    </Reference>
    <!-- The mesh asset tests read the asset back with OpenMetaverse's FacetedMesh and LLSD parser, as OpenSim does. -->
    <Reference Include="OpenMetaverse">
      <HintPath>$(GgRoot)bin\OpenMetaverse.dll</HintPath>
    </Reference>
    <Reference Include="OpenMetaverseTypes">
      <HintPath>$(GgRoot)bin\OpenMetaverseTypes.dll</HintPath>
    </Reference>
    <Reference Include="OpenMetaverse.StructuredData">
      <HintPath>$(GgRoot)bin\OpenMetaverse.StructuredData.dll</HintPath>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <!-- The native JPEG2000 encoder, found the way the converter finds it in bin/: next to OpenMetaverse.dll, in lib64/. -->
    <None Include="$(GgRoot)bin/OpenMetaverse.dll.config" Link="OpenMetaverse.dll.config" CopyToOutputDirectory="PreserveNewest" />
    <None Include="$(GgRoot)bin/lib64/*openjpeg-dotnet*" Link="lib64/%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <None Include="Models/**" Link="Models/%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <None Include="../fixtures/model-import/*.json" Link="fixtures/model-import/%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
