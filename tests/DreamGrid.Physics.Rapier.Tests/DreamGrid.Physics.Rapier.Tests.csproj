<Project Sdk="Microsoft.NET.Sdk">

  <!-- Tests for the Rapier physics backend under BulletS: the native library and its P/Invoke layer. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <EnableUnsafeBinaryFormatterSerialization>true</EnableUnsafeBinaryFormatterSerialization>
  </PropertyGroup>

  <ItemGroup>
    <!-- Runs on Microsoft.Testing.Platform (selected in global.json); no VSTest packages needed. -->
    <PackageReference Include="xunit.v3" Version="4.0.2" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../../OpenSim/Region/PhysicsModules/BulletS/OpenSim.Region.PhysicsModule.BulletS.csproj" />
    <ProjectReference Include="../../OpenSim/Region/PhysicsModules/SharedBase/OpenSim.Region.PhysicsModules.SharedBase.csproj" />
    <ProjectReference Include="../../OpenSim/Region/PhysicsModules/Meshing/OpenSim.Region.PhysicsModule.Meshing.csproj" />
    <ProjectReference Include="../../OpenSim/Framework/OpenSim.Framework.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="OpenMetaverse">
      <HintPath>$(DgRoot)bin/OpenMetaverse.dll</HintPath>
    </Reference>
    <Reference Include="OpenMetaverseTypes">
      <HintPath>$(DgRoot)bin/OpenMetaverseTypes.dll</HintPath>
    </Reference>
    <Reference Include="log4net">
      <HintPath>$(DgRoot)bin/log4net.dll</HintPath>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <!-- The native libraries and the BulletS dllmap file, laid out beside the test assembly as they are in bin/. -->
    <None Include="$(DgRoot)bin/lib64/**" Link="lib64/%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <None Include="$(DgRoot)bin/OpenSim.Region.PhysicsModule.BulletS.dll.config" Link="OpenSim.Region.PhysicsModule.BulletS.dll.config" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
