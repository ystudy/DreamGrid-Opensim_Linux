# The Rapier source the shipped native library is built from (read by build-linux.sh, build-windows.ps1 and the workflow).
# RAPIER_COMMIT is the commit the upstream tag RAPIER_TAG points to; the scripts fetch the commit, not the tag.
RAPIER_REPO=https://github.com/dimforge/rapier.git
RAPIER_TAG=v0.36.1
RAPIER_COMMIT=3406750a38286a0d3c7d0f4be2f9d53153e81d90
RAPIER_FFI_PACKAGE=rapier3d-ffi
# The exact Rust toolchain the shipped libraries are built with (rapier3d-ffi needs 1.99 or newer). Used as `cargo +VERSION`.
RUST_TOOLCHAIN=1.99.1
# Parry, Rapier's collision library, is built from this crates.io release with patches/parry3d-$PARRY_VERSION-edge-codes.patch
# applied (see README.md). PARRY_CRATE_SHA256 is the SHA-256 of the .crate file, the checksum Cargo.lock had for it.
PARRY_VERSION=0.31.1
PARRY_CRATE_SHA256=7b626edc0b497dba4bdf6e1e0797895294ed9f61dac2bd28cb5d34d37ad2ca7e
