+
+    /// EDGE-CODES PATCH: computes `edge_codes`.
+    ///
+    /// For each edge, Parry's edge pseudo-normal is the normalised sum of the normals of every
+    /// triangle using that edge (`compute_pseudo_normals`). All those normals are orthogonal to
+    /// the edge, so the pseudo-normal is `cos(phi) n + sin(phi) (e x n)` for the triangle's normal
+    /// `n` and edge direction `e`: storing `phi` is enough. `phi` is clamped to [-pi/2, pi/2]
+    /// (it only leaves that range on folded or non-manifold edges) and quantised to 10 bits;
+    /// 0 means a flat seam or a boundary (pseudo-normal = face normal, exactly as before), and
+    /// `EDGE_CODE_DEGENERATE` a sum that cannot be normalised (two opposite faces), for which
+    /// the unpatched code returned no constraints for the triangle.
+    #[cfg(feature = "dim3")]
+    fn compute_edge_codes(&mut self) {
+        let mut sums: HashMap<SortedPair<u32>, Vector> = HashMap::default();
+        for (i, idx) in self.indices.iter().enumerate() {
+            if let Some(n) = self.triangle(i as u32).normal() {
+                for k in 0..3 {
+                    *sums
+                        .entry(SortedPair::new(idx[k], idx[(k + 1) % 3]))
+                        .or_insert(Vector::ZERO) += n;
+                }
+            }
+        }
+
+        let scale = EDGE_CODE_MAX as Real / FRAC_PI_2;
+        let codes = (0..self.indices.len())
+            .map(|i| {
+                let tri = self.triangle(i as u32);
+                let Some(n) = tri.normal() else {
+                    return 0; // triangle_normal_constraints returns None for it anyway.
+                };
+                let idx = self.indices[i];
+                let pts = [tri.a, tri.b, tri.c];
+                let mut packed = 0u32;
+                for k in 0..3 {
+                    let sum = sums
+                        .get(&SortedPair::new(idx[k], idx[(k + 1) % 3]))
+                        .copied()
+                        .unwrap_or(n);
+                    let code = if sum.try_normalize().is_none() {
+                        EDGE_CODE_DEGENERATE
+                    } else {
+                        let side = (pts[(k + 1) % 3] - pts[k]).normalize_or_zero().cross(n);
+                        let phi = sum.dot(side).atan2(sum.dot(n)).clamp(-FRAC_PI_2, FRAC_PI_2);
+                        (phi * scale).round() as i32
+                    };
+                    packed |= ((code as u32) & EDGE_CODE_MASK) << (EDGE_CODE_BITS * k as u32);
+                }
+                packed
+            })
+            .collect();
+        self.edge_codes = Some(codes);
+    }
