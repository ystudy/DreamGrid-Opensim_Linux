[Unit]
Description=GridGate (OpenSim grid launcher and admin website)
After=network-online.target
Wants=network-online.target

[Service]
Type=notify
User=gridgate
Group=gridgate
UMask=0077
# The website's content root is the working directory: its styles and scripts are in launcher/wwwroot.
WorkingDirectory=/opt/gridgate/launcher
Environment=DOTNET_ROOT=/opt/gridgate/dotnet DOTNET_HOST_PATH=/opt/gridgate/dotnet/dotnet DOTNET_CLI_TELEMETRY_OPTOUT=1
# install.sh replaces /opt/gridgate/dotnet with the versioned runtime folder /opt/gridgate-runtime/<version>. The web
# port is in the settings (install.sh --web-port runs the launcher's set-web-port); --web-port never goes on ExecStart,
# where the launcher would re-apply it on every start.
ExecStart=/opt/gridgate/dotnet/dotnet /opt/gridgate/launcher/GridGate.Launcher.dll --data /var/lib/gridgate --opensim /opt/gridgate/bin --mariadb-bin /usr/sbin
# Only the launcher stops with the service: MariaDB, Robust and the region keep running and the next start adopts them.
KillMode=process
Restart=on-failure
RestartSec=5
TimeoutStopSec=60

[Install]
WantedBy=multi-user.target
