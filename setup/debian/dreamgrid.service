[Unit]
Description=DreamGrid (OpenSim grid launcher and admin website)
After=network-online.target
Wants=network-online.target

[Service]
Type=notify
User=dreamgrid
Group=dreamgrid
UMask=0077
# The website's content root is the working directory: its styles and scripts are in launcher/wwwroot.
WorkingDirectory=/opt/dreamgrid/launcher
Environment=DOTNET_ROOT=/opt/dreamgrid/dotnet DOTNET_HOST_PATH=/opt/dreamgrid/dotnet/dotnet DOTNET_CLI_TELEMETRY_OPTOUT=1
# install.sh appends --web-port <n> to this line when it was given one.
ExecStart=/opt/dreamgrid/dotnet/dotnet /opt/dreamgrid/launcher/DreamGrid.Launcher.dll --data /var/lib/dreamgrid --opensim /opt/dreamgrid/bin --mariadb-bin /usr/sbin
# Only the launcher stops with the service: MariaDB, Robust and the region keep running and the next start adopts them.
KillMode=process
Restart=on-failure
RestartSec=5
TimeoutStopSec=60

[Install]
WantedBy=multi-user.target
